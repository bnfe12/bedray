#version 450
// Vulkan 1.0 compute only: no ray queries, acceleration structures or device addresses.
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0, rgba8) uniform writeonly image2D outputImage;
layout(std430, binding=1) readonly buffer Grid { uvec4 dimensions; uint cells[]; } grid;
#ifdef TEXTURED_CUBES
// 32-byte face ABI: UV origin/du, dv, packed opaque ARGB tint, reserved.
struct CubeFace { vec4 originDu; vec2 dv; uint tint; uint reserved; };
layout(std430, binding=2) readonly buffer CubePalette { CubeFace faces[]; } palette;
layout(binding=3) uniform sampler2D blockAtlas;
#endif
layout(push_constant) uniform Diagnostic {
    mat4 inverseViewProjection;
    vec4 cameraOrigin;
    uvec4 control; // bit 0: hit IDs, bit 1: live section tiles
    vec4 rayOriginOffset;
} diagnostic;

struct Hit { bool found; ivec3 cell; uint material; float t; vec3 normal; };
Hit miss() { return Hit(false, ivec3(0), 0u, 0.0, vec3(0)); }

Hit trace(vec3 origin, vec3 direction, float minT, float maxT) {
    ivec3 size = ivec3(grid.dimensions.xyz);
    float enter = -3.402823466e38;
    float leave = maxT;
    vec3 enterNormal = vec3(0);
    for (int a=0; a<3; ++a) {
        if (direction[a] == 0.0) {
            if (origin[a] < 0.0 || origin[a] >= float(size[a])) return miss();
        } else {
            float t0 = -origin[a] / direction[a];
            float t1 = (float(size[a]) - origin[a]) / direction[a];
            float nearT = min(t0, t1), farT = max(t0, t1);
            if (nearT > enter) {
                enter = nearT;
                enterNormal = vec3(0); enterNormal[a] = direction[a] > 0.0 ? -1.0 : 1.0;
            }
            leave = min(leave, farT);
        }
    }
    float t = max(minT, enter);
    if (t >= leave) return miss();
    vec3 p = fma(vec3(t), direction, origin);
    ivec3 cell = ivec3(floor(p));
    ivec3 stepDirection = ivec3(sign(direction));
    vec3 nextT = vec3(3.402823466e38);
    vec3 delta = vec3(3.402823466e38);
    for (int a=0; a<3; ++a) {
        if (direction[a] < 0.0 && p[a] == floor(p[a])) cell[a]--;
        // Slab roundoff may put an entry point just beyond the outer face.
        cell[a] = clamp(cell[a], 0, size[a]-1);
        if (direction[a] != 0.0) {
            float edge = float(cell[a] + (direction[a] > 0.0 ? 1 : 0));
            nextT[a] = (edge-origin[a])/direction[a];
            delta[a] = abs(1.0/direction[a]);
        }
    }
    vec3 normal = enter < minT ? vec3(0) : enterNormal;
    // Every step crosses at least one cell; sum dimensions bounds an entire box traversal.
    int limit = size.x+size.y+size.z+1;
    for (int iteration=0; iteration<limit; ++iteration) {
        if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(cell,size)) || t >= leave) break;
        uint index = uint(cell.x + size.x*(cell.y+size.y*cell.z));
        if (index >= grid.dimensions.w) return miss();
        float boundary = min(nextT.x, min(nextT.y,nextT.z));
        if ((diagnostic.control.x & 2u) != 0u) {
            ivec3 tile = cell / 16;
            ivec3 local = cell % 16;
            index = uint(tile.x+3*(tile.y+3*tile.z))*4096u + uint(local.x+16*(local.y+16*local.z));
        }
        if (index >= grid.dimensions.w) return miss();
        uint material = grid.cells[index];
        // Occupancy is not an optical material. Shaded live mode traces only supported cubes.
        // The occupancy view keeps explicit unsupported/unknown diagnostic marker cells.
        if ((diagnostic.control.x & 2u) != 0u) {
            if (diagnostic.control.y == 3u) {
                if (material == 0xffffffffu) material = 3u;
                else material &= 255u;
            } else if ((material & 255u) != 1u) material = 0u;
        }
        if (material != 0u && t < min(boundary,leave)) return Hit(true, cell, material, t, normal);
        if (boundary >= leave) break;
        normal = vec3(0);
        bool selected = false;
        for (int a=0; a<3; ++a) {
            if (nextT[a] == boundary) {
                cell[a] += stepDirection[a];
                nextT[a] += delta[a];
                if (!selected) { normal[a] = -float(stepDirection[a]); selected = true; }
            }
        }
        t = max(t,boundary);
    }
    return miss();
}

vec3 materialColor(uint id) {
    if (id==1u) return vec3(0.42,0.52,0.30);
    if (id==2u) return vec3(0.63,0.32,0.18);
    if (id==3u) return vec3(0.52,0.57,0.62);
    return vec3(0.95,0.66,0.22);
}

#ifdef TEXTURED_CUBES
vec3 srgbToLinear(vec3 value) {
    return mix(value/12.92, pow((value+0.055)/1.055,vec3(2.4)), greaterThan(value,vec3(0.04045)));
}

vec3 linearToSrgb(vec3 value) {
    return mix(value*12.92, 1.055*pow(value,vec3(1.0/2.4))-0.055, greaterThan(value,vec3(0.0031308)));
}

vec3 cubeAlbedo(Hit hit, vec3 point) {
    uint reference = hit.material >> 8;
    if (reference == 0u || reference > 128u || dot(hit.normal,hit.normal) < 0.5) return vec3(0.65);
    vec3 local = clamp(point-vec3(hit.cell),vec3(0),vec3(1));
    uint face;
    vec2 coordinates;
    if (hit.normal.y != 0.0) {
        face = hit.normal.y < 0.0 ? 0u : 1u;
        coordinates = local.xz;
    } else if (hit.normal.z != 0.0) {
        face = hit.normal.z < 0.0 ? 2u : 3u;
        coordinates = local.xy;
    } else {
        face = hit.normal.x < 0.0 ? 4u : 5u;
        coordinates = local.zy;
    }
    ivec3 tile = hit.cell/16;
    uint slot = uint(tile.x+3*(tile.y+3*tile.z));
    uint index = (slot*128u+reference-1u)*6u+face;
    if (index >= uint(palette.faces.length())) return vec3(0.65);
    CubeFace surface = palette.faces[index];
    vec2 uvOrigin = surface.originDu.xy;
    vec2 du = surface.originDu.zw;
    vec2 uv = uvOrigin+du*coordinates.x+surface.dv*coordinates.y;
    vec2 low = min(min(uvOrigin,uvOrigin+du),min(uvOrigin+surface.dv,uvOrigin+du+surface.dv));
    vec2 high = max(max(uvOrigin,uvOrigin+du),max(uvOrigin+surface.dv,uvOrigin+du+surface.dv));
    // LOD zero and a per-sprite half-texel inset prevent nearest sampling into adjacent atlas sprites.
    vec2 inset = min(vec2(0.5)/vec2(textureSize(blockAtlas,0)),(high-low)*0.5);
    uv = clamp(uv,low+inset,high-inset);
    vec3 tint = vec3(float((surface.tint>>16)&255u),float((surface.tint>>8)&255u),float(surface.tint&255u))/255.0;
    // The borrowed RGBA8_UNORM view does not perform hardware sRGB decoding.
    return srgbToLinear(textureLod(blockAtlas,uv,0.0).rgb)*srgbToLinear(tint);
}
#endif

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 resolution = imageSize(outputImage);
    if (any(greaterThanEqual(pixel,resolution))) return;
    vec2 uv = (vec2(pixel)+0.5)/vec2(resolution)*2.0-1.0;
    uv.x *= float(resolution.x)/float(resolution.y);
    // Deliberately fixed camera: this mode diagnoses traversal, not the live Minecraft scene.
    vec3 origin = vec3(38,24,43);
    vec3 forward = normalize(vec3(16,5,16)-origin);
    vec3 right = normalize(cross(forward,vec3(0,1,0)));
    vec3 up = cross(right,forward);
    vec3 ray = normalize(forward + 0.62*uv.x*right - 0.62*uv.y*up);
    if ((diagnostic.control.x & 2u) != 0u) {
        vec2 ndc = (vec2(pixel)+0.5)/vec2(resolution)*2.0-1.0;
        // Any interior depth works with reverse-Z as well as conventional projections.
        vec4 point = diagnostic.inverseViewProjection * vec4(ndc,0.5,1.0);
        if (abs(point.w) < 1e-8 || any(isnan(point)) || any(isinf(point))) {
            imageStore(outputImage,pixel,vec4(1,0,1,1)); return;
        }
        origin = diagnostic.cameraOrigin.xyz + diagnostic.rayOriginOffset.xyz;
        if (any(isnan(origin)) || any(isinf(origin))) {
            imageStore(outputImage,pixel,vec4(1,0,1,1)); return;
        }
        vec3 direction = point.xyz/point.w-diagnostic.rayOriginOffset.xyz;
        float lengthSquared = dot(direction,direction);
        if (lengthSquared < 1e-16 || isnan(lengthSquared) || isinf(lengthSquared)) {
            imageStore(outputImage,pixel,vec4(1,0,1,1)); return;
        }
        ray = direction*inversesqrt(lengthSquared);
    }
    Hit hit = trace(origin,ray,0.0,160.0);
    if ((diagnostic.control.x & 1u) != 0u) {
        // Exact byte IDs for CPU/GPU traversal comparison, not shaded color.
        uint id = (diagnostic.control.x & 2u) != 0u ? hit.material & 255u : hit.material;
        imageStore(outputImage,pixel,hit.found ? vec4(vec3(hit.cell),float(id))/255.0 : vec4(0));
        return;
    }
    vec3 color = mix(vec3(0.40,0.57,0.74),vec3(0.09,0.16,0.28),clamp(ray.y*0.5+0.5,0.0,1.0));
    if (hit.found) {
        vec3 sun = normalize(vec3(-0.5,1.0,0.3));
        vec3 p = origin+hit.t*ray;
        Hit shadow = trace(p+hit.normal*0.002,sun,0.0,100.0);
        float direct = shadow.found ? 0.0 : max(0.0,dot(hit.normal,sun));
        vec3 albedo = (diagnostic.control.x & 2u) != 0u ? vec3(0.65) : materialColor(hit.material);
#ifdef TEXTURED_CUBES
        if ((diagnostic.control.x & 2u) != 0u) albedo = cubeAlbedo(hit,p);
#endif
        color = albedo*(0.22+0.78*direct);
    }
    if (diagnostic.control.y == 1u) color = hit.found ? hit.normal*0.5+0.5 : vec3(0);
    if (diagnostic.control.y == 2u) color = hit.found ? vec3(clamp(hit.t/96.0,0.0,1.0)) : vec3(0);
    if (diagnostic.control.y == 3u) color = !hit.found ? vec3(0)
        : ((diagnostic.control.x & 2u) != 0u && hit.material == 3u) ? vec3(0.08,0.24,0.85)
        : ((diagnostic.control.x & 2u) != 0u && hit.material == 2u) ? vec3(0.75,0.10,0.65) : vec3(1);
    // Diagnostic LDR output only. The future world renderer will share Bedray's HDR/tonemap contract.
    color = clamp(color,0.0,1.0);
    // Blitting to sRGB performs destination encoding. Avoid applying gamma twice in that case.
    if ((diagnostic.control.x & 4u) == 0u) {
#ifdef TEXTURED_CUBES
        color = linearToSrgb(color);
#else
        color = pow(color,vec3(1.0/2.2));
#endif
    }
    imageStore(outputImage,pixel,vec4(color,1.0));
}
