// Bilinear reprojection; each tap is accepted only if its stored distance from the previous eye and
// its normal match this surface point (validation tolerances, not physical constants).
vec3 accumulate(ivec2 pixel, ivec2 resolution, vec3 point, vec3 normal, vec3 radiance, out float count) {
    count=1.0;
    if (environment.info.y==0u) return radiance;
    vec4 clip=environment.previousViewProjection*vec4(point-environment.previousCamera.xyz,1.0);
    if (clip.w<=1e-6) return radiance;
    vec2 position=(clip.xy/clip.w*0.5+0.5)*vec2(resolution)-0.5;
    if (any(isnan(position)) || any(isinf(position))) return radiance;
    ivec2 base=ivec2(floor(position));
    vec2 fraction=position-vec2(base);
    float expected=length(point-environment.previousEye.xyz);
    vec3 sum=vec3(0); float weights=0.0, counts=0.0;
    for (int tap=0; tap<4; tap++) {
        ivec2 offset=ivec2(tap&1,tap>>1), q=base+offset;
        if (any(lessThan(q,ivec2(0))) || any(greaterThanEqual(q,resolution))) continue;
        uvec4 stored=loadHistory(q);
        vec2 rg=unpackHalf2x16(stored.x), bc=unpackHalf2x16(stored.y);
        if (bc.y<0.5) continue;
        float distance=uintBitsToFloat(stored.z);
        if (abs(distance-expected)>0.02*expected+0.05) continue;
        if (dot(octDecode(unpackSnorm2x16(stored.w)),normal)<0.9) continue;
        float w=(offset.x==1 ? fraction.x : 1.0-fraction.x)*(offset.y==1 ? fraction.y : 1.0-fraction.y);
        sum+=w*vec3(rg,bc.x); counts+=w*bc.y; weights+=w;
    }
    if (weights<0.05) return radiance;
    count=min(counts/weights+1.0,float(max(environment.info.z,1u)));
    return mix(sum/weights,radiance,1.0/count);
}
