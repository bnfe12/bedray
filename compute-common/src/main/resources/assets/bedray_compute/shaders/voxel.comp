    key*=inversesqrt(square);
    vec3 direction=coneSample(key,cos(KEY_ANGULAR_RADIUS),seed);
    float cosine=dot(normal,direction);
    if (cosine<=0.0) return vec3(0);
    vec3 filterColor;
    Hit blocker=traceOpaque(point+normal*0.003,direction,sceneDistance(),filterColor);
    if (blocker.found) return vec3(0);
