    escaped=!hit.found;
    distance=hit.found ? hit.t : sceneDistance();
    if (!hit.found) return skyRadiance()*originSky*filterColor;
    if ((hit.flags&FLAG_NO_MATERIAL)!=0u) return vec3(0);
    vec3 point=origin+hit.t*direction;
    vec3 albedo=hitAlbedo(hit,point);
    vec3 emitted=blockColor()*lightResponse(float(emissionLevel(hit)));
    return filterColor*albedo*(secondaryIrradiance(point,hit.normal,seed)+emitted);
