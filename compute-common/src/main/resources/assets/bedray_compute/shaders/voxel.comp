#version 450
// Vulkan 1.0 compute only; no ray queries, acceleration structures or device addresses.
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0, rgba8) uniform writeonly image2D outputImage;
// Live textured grids append one ARGB cell tint per cell after the occupancy cells (index + dimensions.w).
#ifdef STREAMED_WORLD
// 64-byte header, then a bounded hash directory (12 words/entry) and resident cell/tint arena.
// Directory: absolute section xyz/state, cells/tints/palette/header offsets, quad offset/counts.
layout(std430, binding=1) readonly buffer Grid {
    uvec4 dimensions; ivec4 boundsMin; ivec4 originSection; uvec4 pageInfo; uint words[];
} grid;
#else
layout(std430, binding=1) readonly buffer Grid { uvec4 dimensions; uint cells[]; } grid;
#endif
#ifdef TEXTURED_CUBES
// flags bit0: multiply by the cell tint (API minor 5).
struct CubeFace { vec4 originDu; vec2 dv; uint tint; uint flags; };
layout(std430, binding=2) readonly buffer CubePalette { CubeFace faces[]; } palette;
layout(binding=3) uniform sampler2D blockAtlas;
// 96-byte ABI: twenty interleaved xyzuv floats, tint/flags/emission/reserved.
// flags: 1 cutout, 2 translucent, 4 cell tint, 8 fluid surface.
struct ModelQuad { vec4 vertices[5]; uvec4 metadata; };
// 27*128 headers occupy 55,296 bytes, followed by 27 fixed 8192-quad slabs.
#ifdef STREAMED_WORLD
layout(std430, binding=4) readonly buffer Models { uint words[]; } models;
#else
layout(std430, binding=4) readonly buffer Models { uvec4 headers[3456]; ModelQuad quads[]; } models;
#endif
const uint MAX_EMITTERS=128u;
// values: LightingFrame (key dir/enabled, key RGB/sky factor, sky RGB/ambient factor, block RGB/factor,
// ambient RGB/brightness, darkness/night vision/boss darkening). info: emitters, history valid, history cap, motion.
layout(std430, binding=5) readonly buffer Environment {
    vec4 values[6];
    mat4 previousViewProjection;
    vec4 previousCamera;
    vec4 previousEye;
    uvec4 info;
    vec4 emitters[2u*MAX_EMITTERS]; // center xyz + equal-area radius; level, cell xyz
} environment;
#endif
#ifdef RASTER_INPUTS
layout(binding=6) uniform sampler2D rasterColor;
layout(binding=7) uniform sampler2D rasterDepth;
// Ping-pong history: half rgb radiance + sample count, hit distance, octahedral normal.
layout(binding=8, rgba32ui) uniform uimage2D historyA;
layout(binding=9, rgba32ui) uniform uimage2D historyB;
#endif
layout(push_constant) uniform Diagnostic {
    mat4 inverseViewProjection;
    vec4 cameraOrigin;
    // x: IDs=1, live=2, sRGB destination=4, world light=8, sRGB raster view=16, history parity=32.
    // y: debug view. z: frame counter (random sequence). w: reserved.
    uvec4 control;
    vec4 rayOriginOffset;
} diagnostic;
const uint FLAG_CUTOUT=1u, FLAG_TRANSLUCENT=2u, FLAG_CELL_TINT=4u, FLAG_FLUID=8u, FLAG_NO_MATERIAL=16u;
struct Hit {
    bool found; ivec3 cell; uint material; float t; vec3 normal;
    vec3 albedo; uint flags; float emission; float alpha;
};
Hit miss() { return Hit(false,ivec3(0),0u,0.0,vec3(0),vec3(0),0u,0.0,0.0); }
vec3 boundsMinimum() {
#ifdef STREAMED_WORLD
    return vec3(grid.boundsMin.xyz);
#else
    return vec3(0);
#endif
}
float sceneDistance() {
#ifdef STREAMED_WORLD
    return length(vec3(grid.dimensions.xyz));
#else
    return 160.0;
#endif
}
bool diffuseBounceEnabled() {
#ifdef STREAMED_WORLD
    return (grid.pageInfo.w&1u)!=0u;
#else
    return true;
#endif
}
bool translucentOpticsEnabled() {
#ifdef STREAMED_WORLD
    return (grid.pageInfo.w&2u)!=0u;
#else
    return true;
#endif
}
#ifdef STREAMED_WORLD
uint sectionPage(ivec3 cell) {
    ivec3 key=ivec3(floor(vec3(cell)/16.0))+grid.originSection.xyz;
    uint h=uint(key.x)*0x8da6b343u^uint(key.y)*0xd8163841u^uint(key.z)*0xcb1ab31fu;
    h^=h>>16;h*=0x7feb352du;h^=h>>15;
    uint index=h&(grid.pageInfo.x-1u);
    for(uint probe=0u;probe<grid.pageInfo.z;probe++,index=(index+1u)&(grid.pageInfo.x-1u)) {
        uint address=index*12u,state=grid.words[address+3u];
        if(state==0u)return 0xffffffffu;
        if(state!=3u&&ivec3(grid.words[address],grid.words[address+1u],grid.words[address+2u])==key)return address;
    }
    return 0xffffffffu;
}
#endif
uint cellIndex(ivec3 cell) {
#ifdef STREAMED_WORLD
    uint page=sectionPage(cell);
    if(page==0xffffffffu||grid.words[page+3u]!=2u)return 0xffffffffu;
    ivec3 local=cell&ivec3(15);
    return grid.words[page+4u]+uint(local.x+16*(local.y+16*local.z));
#else
    ivec3 size=ivec3(grid.dimensions.xyz);
    if (any(lessThan(cell,ivec3(0))) || any(greaterThanEqual(cell,size))) return 0xffffffffu;
    uint index=uint(cell.x+size.x*(cell.y+size.y*cell.z));
    if ((diagnostic.control.x&2u)!=0u) {
        ivec3 tile=cell/16, local=cell%16;
        index=uint(tile.x+3*(tile.y+3*tile.z))*4096u+uint(local.x+16*(local.y+16*local.z));
    }
    return index<grid.dimensions.w ? index : 0xffffffffu;
#endif
}
uint cellValue(ivec3 cell) {
#ifdef STREAMED_WORLD
    if(any(lessThan(vec3(cell),boundsMinimum()))||any(greaterThanEqual(vec3(cell),boundsMinimum()+vec3(grid.dimensions.xyz))))return 0xffffffffu;
    uint page=sectionPage(cell);
    if(page==0xffffffffu)return 0xffffffffu;
    if(grid.words[page+3u]==1u)return grid.words[page+8u];
    ivec3 local=cell&ivec3(15);
    uint index=grid.words[page+4u]+uint(local.x+16*(local.y+16*local.z));
    return index<uint(grid.words.length())?grid.words[index]:0xffffffffu;
#else
    uint index=cellIndex(cell);
    return index==0xffffffffu ? 0xffffffffu : grid.cells[index];
#endif
}
#ifdef TEXTURED_CUBES
const float PI=3.14159265358979;
// Mean angular radius of the Sun (0.2666 degrees); the Moon's is within two percent of it.
const float KEY_ANGULAR_RADIUS=0.004653;
// A level-15 sphere emitter at this distance contributes below 1/1000 of its 1-block irradiance.
const float EMITTER_RANGE=32.0;
// Water's refractive index at visible wavelengths; other translucent surfaces use crown glass.
const float WATER_IOR=1.333, GLASS_IOR=1.5;
vec3 srgbToLinear(vec3 value) {
    return mix(value/12.92,pow((value+0.055)/1.055,vec3(2.4)),greaterThan(value,vec3(0.04045)));
}
vec3 linearToSrgb(vec3 value) {
    return mix(value*12.92,1.055*pow(value,vec3(1.0/2.4))-0.055,greaterThan(value,vec3(0.0031308)));
}
vec3 tintColor(uint tint) {
    return srgbToLinear(vec3(float((tint>>16)&255u),float((tint>>8)&255u),float(tint&255u))/255.0);
}
vec3 cellTint(ivec3 cell) {
#ifdef STREAMED_WORLD
    uint page=sectionPage(cell);
    if(page==0xffffffffu||grid.words[page+3u]!=2u)return vec3(1);
    ivec3 local=cell&ivec3(15);
    uint value=grid.words[grid.words[page+5u]+uint(local.x+16*(local.y+16*local.z))];
#else
    uint index=cellIndex(cell);
    if (index==0xffffffffu) return vec3(1);
    uint value=grid.cells[grid.dimensions.w+index];
#endif
    return value==0u ? vec3(1) : tintColor(value);
}
float quadComponent(ModelQuad quad, int index) { return quad.vertices[index/4][index%4]; }
vec3 vertexPosition(ModelQuad quad, int vertex) {
    int i=vertex*5;
    return vec3(quadComponent(quad,i),quadComponent(quad,i+1),quadComponent(quad,i+2));
}
vec2 vertexUv(ModelQuad quad, int vertex) { return vec2(quadComponent(quad,vertex*5+3),quadComponent(quad,vertex*5+4)); }
bool triangle(vec3 origin, vec3 ray, vec3 a, vec3 b, vec3 c, vec2 ta, vec2 tb, vec2 tc,
              float minT, float maxT, out float t, out vec2 uv, out vec3 normal) {
    vec3 e1=b-a, e2=c-a, p=cross(ray,e2);
    float determinant=dot(e1,p);
    if (abs(determinant)<1e-9) return false;
    float inverse=1.0/determinant;
    vec3 s=origin-a, q=cross(s,e1);
    float u=dot(s,p)*inverse, v=dot(ray,q)*inverse;
    if (u < -1e-6 || v < -1e-6 || u+v > 1.000001) return false;
    t=dot(e2,q)*inverse;
    // Preserve geometry exactly on a DDA cell boundary despite floating-point roundoff.
    if (t < max(0.0,minT-0.0002) || t > maxT+0.0002) return false;
    normal=cross(e1,e2);
    float square=dot(normal,normal);
    if (square<1e-16) return false;
    normal*=inversesqrt(square);
    if (dot(normal,ray)>0.0) normal=-normal;
    uv=ta+(tb-ta)*u+(tc-ta)*v;
    return true;
}
Hit modelHit(vec3 origin, vec3 ray, ivec3 cell, uint material, float minT, float maxT) {
    uint reference=(material>>8)&255u;
    if (reference==0u || reference>128u) return miss();
#ifdef STREAMED_WORLD
    uint page=sectionPage(cell);
    if(page==0xffffffffu||reference>grid.words[page+9u])return miss();
    uint headerAddress=grid.words[page+7u]+(reference-1u)*4u;
    if(headerAddress+3u>=uint(models.words.length()))return miss();
    uvec4 header=uvec4(models.words[headerAddress],models.words[headerAddress+1u],models.words[headerAddress+2u],models.words[headerAddress+3u]);
    if(header.y==0u||header.y>64u)return miss();
#else
    ivec3 tile=cell/16;
    uint slot=uint(tile.x+3*(tile.y+3*tile.z));
    uvec4 header=models.headers[slot*128u+reference-1u];
    if (header.y==0u || header.y>64u || header.x+header.y>8192u) return miss();
#endif
    Hit best=miss();
    float nearest=maxT;
    for (uint index=0u; index<header.y; index++) {
#ifdef STREAMED_WORLD
        uint address=grid.words[page+7u]+grid.words[page+8u]+(header.x+index)*24u;
        if(address+23u>=uint(models.words.length()))return miss();
        ModelQuad quad;
        for(int word=0;word<20;word++)quad.vertices[word/4][word%4]=uintBitsToFloat(models.words[address+uint(word)]);
        quad.metadata=uvec4(models.words[address+20u],models.words[address+21u],models.words[address+22u],models.words[address+23u]);
#else
        uint address=slot*8192u+header.x+index;
        if (address>=uint(models.quads.length())) return miss();
        ModelQuad quad=models.quads[address];
#endif
        vec3 a=vertexPosition(quad,0), b=vertexPosition(quad,1), c=vertexPosition(quad,2), d=vertexPosition(quad,3);
        vec2 ta=vertexUv(quad,0), tb=vertexUv(quad,1), tc=vertexUv(quad,2), td=vertexUv(quad,3);
        vec2 low=min(min(ta,tb),min(tc,td)), high=max(max(ta,tb),max(tc,td));
        vec2 inset=min(vec2(0.5)/vec2(textureSize(blockAtlas,0)),(high-low)*0.5);
        for (int part=0; part<2; part++) {
            float t; vec2 uv; vec3 normal;
            bool accepted=part==0
                ? triangle(origin-vec3(cell),ray,a,b,c,ta,tb,tc,minT,maxT,t,uv,normal)
                : triangle(origin-vec3(cell),ray,c,d,a,tc,td,ta,minT,maxT,t,uv,normal);
            if (!accepted || (best.found && t>nearest+0.00001)) continue;
            vec4 texel=textureLod(blockAtlas,clamp(uv,low+inset,high-inset),0.0);
            // Test each triangle's alpha before nearest selection, including nonplanar quads.
            // Later accepted coplanar overlays win; transparent overlays leave the base intact.
            if (texel.a<0.1) continue;
            vec3 tint=tintColor(quad.metadata.x);
            if ((quad.metadata.y&FLAG_CELL_TINT)!=0u) tint*=cellTint(cell);
            best=Hit(true,cell,material,max(0.0,t),normal,srgbToLinear(texel.rgb)*tint,
                quad.metadata.y,float(quad.metadata.z)/15.0,texel.a);
            nearest=t;
        }
    }
    return best;
}
#endif
Hit trace(vec3 origin, vec3 direction, float minT, float maxT) {
    ivec3 size=ivec3(grid.dimensions.xyz);
    ivec3 minimum=ivec3(boundsMinimum()),maximum=minimum+size;
    float enter=-3.402823466e38, leave=maxT;
    vec3 enterNormal=vec3(0);
    for (int a=0; a<3; a++) {
        if (direction[a]==0.0) {
            if (origin[a]<float(minimum[a]) || origin[a]>=float(maximum[a])) return miss();
        } else {
            float t0=(float(minimum[a])-origin[a])/direction[a], t1=(float(maximum[a])-origin[a])/direction[a];
            float nearT=min(t0,t1), farT=max(t0,t1);
            if (nearT>enter) {
                enter=nearT; enterNormal=vec3(0); enterNormal[a]=direction[a]>0.0 ? -1.0 : 1.0;
            }
            leave=min(leave,farT);
        }
    }
    float t=max(minT,enter);
    if (t>=leave) return miss();
    vec3 p=fma(vec3(t),direction,origin);
    ivec3 cell=ivec3(floor(p)), stepDirection=ivec3(sign(direction));
    vec3 nextT=vec3(3.402823466e38), delta=vec3(3.402823466e38);
    for (int a=0; a<3; a++) {
        if (direction[a]<0.0 && p[a]==floor(p[a])) cell[a]--;
        cell[a]=clamp(cell[a],minimum[a],maximum[a]-1);
        if (direction[a]!=0.0) {
            nextT[a]=(float(cell[a]+(direction[a]>0.0 ? 1 : 0))-origin[a])/direction[a];
            delta[a]=abs(1.0/direction[a]);
        }
    }
    vec3 normal=enter<minT ? vec3(0) : enterNormal;
    int limit=size.x+size.y+size.z+1;
    for (int iteration=0; iteration<limit; iteration++) {
        if (any(lessThan(cell,minimum)) || any(greaterThanEqual(cell,maximum)) || t>=leave) break;
#ifdef STREAMED_WORLD
        uint page=sectionPage(cell);
        if((page==0xffffffffu&&diagnostic.control.y!=3u)||(page!=0xffffffffu&&grid.words[page+3u]==1u)) {
            // Two-level DDA: an absent/queued or explicit empty section costs one section step.
            // Missing primary surfaces keep raster during composition; they are never opaque cubes.
            vec3 sectionMin=floor(vec3(cell)/16.0)*16.0;
            vec3 sectionExit=vec3(3.402823466e38);
            for(int a=0;a<3;a++)if(direction[a]!=0.0)
                sectionExit[a]=(sectionMin[a]+(direction[a]>0.0?16.0:0.0)-origin[a])/direction[a];
            float jump=min(sectionExit.x,min(sectionExit.y,sectionExit.z));
            if(jump>=leave)break;
            t=max(t,jump);p=fma(vec3(t),direction,origin);cell=ivec3(floor(p));normal=vec3(0);
            bool face=false;
            for(int a=0;a<3;a++) {
                if(direction[a]<0.0&&p[a]==floor(p[a]))cell[a]--;
                if(sectionExit[a]==jump) {
                    // Snap exact crossed planes: fma may otherwise round back into the old section.
                    cell[a]=int(sectionMin[a])+(direction[a]>0.0?16:-1);
                    if(!face){normal[a]=-float(stepDirection[a]);face=true;}
                }
                nextT[a]=direction[a]==0.0?3.402823466e38:(float(cell[a]+(direction[a]>0.0?1:0))-origin[a])/direction[a];
            }
            continue;
        }
#endif
        float boundary=min(nextT.x,min(nextT.y,nextT.z));
        uint material=cellValue(cell);
        bool live=(diagnostic.control.x&2u)!=0u;
        if (live) {
            uint occupancy=material&255u;
            if (diagnostic.control.y==3u) {
                uint marker=material==0xffffffffu ? 4u : occupancy;
                if (marker!=0u && t<min(boundary,leave)) return Hit(true,cell,marker,t,normal,vec3(0),0u,0.0,1.0);
            } else if (material!=0xffffffffu && occupancy==1u && t<min(boundary,leave)) {
                // A cube without a palette entry is a real occluder but has no material to shade.
                uint flags=((material>>8)&255u)==0u ? FLAG_NO_MATERIAL : 0u;
                return Hit(true,cell,material,t,normal,vec3(0.65),flags,float((material>>24)&15u)/15.0,1.0);
#ifdef TEXTURED_CUBES
            } else if (material!=0xffffffffu && occupancy==3u) {
                Hit candidate=modelHit(origin,direction,cell,material,t,min(boundary,leave));
                if (candidate.found) return candidate;
#endif
            }
        } else if (material!=0u && material!=0xffffffffu && t<min(boundary,leave))
            return Hit(true,cell,material,t,normal,vec3(0),0u,0.0,1.0);
        if (boundary>=leave) break;
        bvec3 crossed=equal(nextT,vec3(boundary));
        for (int a=0; a<3; a++) if (crossed[a]) { cell[a]+=stepDirection[a]; nextT[a]+=delta[a]; }
        // An exact edge/corner crossing enters through several faces at once. Report a face whose
        // neighbor outside the entered cell is not an opaque cube, so a floor seen exactly at a cell
        // edge keeps its top face instead of a hidden side face.
        normal=vec3(0); int fallback=-1; bool selected=false;
        for (int a=0; a<3; a++) if (crossed[a]) {
            if (fallback<0) fallback=a;
            ivec3 outside=cell; outside[a]-=stepDirection[a];
            uint neighbor=cellValue(outside);
            if (!selected && (neighbor==0xffffffffu || (neighbor&255u)!=1u)) { normal[a]=-float(stepDirection[a]); selected=true; }
        }
        if (!selected && fallback>=0) normal[fallback]=-float(stepDirection[fallback]);
        t=max(t,boundary);
    }
    return miss();
}
vec3 materialColor(uint id) {
    if (id==1u) return vec3(0.42,0.52,0.30);
    if (id==2u) return vec3(0.63,0.32,0.18);
    if (id==3u) return vec3(0.52,0.57,0.62);
    return vec3(0.95,0.66,0.22);
}
#ifdef TEXTURED_CUBES
// ---- Sampling ----
uint pcg(uint value) {
    uint state=value*747796405u+2891336453u;
    uint word=((state>>((state>>28u)+4u))^state)*277803737u;
    return (word>>22u)^word;
}
float random(inout uint seed) { seed=pcg(seed); return float(seed>>8)*(1.0/16777216.0); }
void basis(vec3 n, out vec3 t, out vec3 b) {
    float s=n.z>=0.0 ? 1.0 : -1.0;
    float a=-1.0/(s+n.z), c=n.x*n.y*a;
    t=vec3(1.0+s*n.x*n.x*a,s*c,-s*n.x);
    b=vec3(c,s+n.y*n.y*a,-n.y);
}
// Cosine-weighted hemisphere direction; pdf = cos(theta)/pi.
vec3 cosineSample(vec3 n, inout uint seed) {
    float u=random(seed), v=random(seed);
    float r=sqrt(u), phi=2.0*PI*v;
    vec3 t, b; basis(n,t,b);
    return normalize(t*(r*cos(phi))+b*(r*sin(phi))+n*sqrt(max(0.0,1.0-u)));
}
// Uniform direction inside a cone; pdf = 1/(2*pi*(1-cosMax)).
vec3 coneSample(vec3 axis, float cosMax, inout uint seed) {
    float u=random(seed), v=random(seed);
    float c=1.0-u*(1.0-cosMax), s=sqrt(max(0.0,1.0-c*c)), phi=2.0*PI*v;
    vec3 t, b; basis(axis,t,b);
    return normalize(t*(s*cos(phi))+b*(s*sin(phi))+axis*c);
}
// ---- Materials and environment ----
vec3 cubeAlbedo(Hit hit, vec3 point) {
    uint reference=(hit.material>>8)&255u;
    if (reference==0u || reference>128u || dot(hit.normal,hit.normal)<0.5) return vec3(0.65);
    vec3 local=clamp(point-vec3(hit.cell),vec3(0),vec3(1));
    uint face; vec2 coordinates;
    if (hit.normal.y!=0.0) { face=hit.normal.y<0.0 ? 0u : 1u; coordinates=local.xz; }
    else if (hit.normal.z!=0.0) { face=hit.normal.z<0.0 ? 2u : 3u; coordinates=local.xy; }
    else { face=hit.normal.x<0.0 ? 4u : 5u; coordinates=local.zy; }
#ifdef STREAMED_WORLD
    uint page=sectionPage(hit.cell);
    if(page==0xffffffffu||reference>grid.words[page+10u])return vec3(0.65);
    uint index=grid.words[page+6u]+(reference-1u)*6u+face;
#else
    ivec3 tile=hit.cell/16;
    uint slot=uint(tile.x+3*(tile.y+3*tile.z));
    uint index=(slot*128u+reference-1u)*6u+face;
#endif
    if (index>=uint(palette.faces.length())) return vec3(0.65);
    CubeFace surface=palette.faces[index];
    vec2 base=surface.originDu.xy, du=surface.originDu.zw;
    vec2 low=min(min(base,base+du),min(base+surface.dv,base+du+surface.dv));
    vec2 high=max(max(base,base+du),max(base+surface.dv,base+du+surface.dv));
    vec2 inset=min(vec2(0.5)/vec2(textureSize(blockAtlas,0)),(high-low)*0.5);
    vec2 uv=clamp(base+du*coordinates.x+surface.dv*coordinates.y,low+inset,high-inset);
    vec3 color=srgbToLinear(textureLod(blockAtlas,uv,0.0).rgb)*tintColor(surface.tint);
    if ((surface.flags&1u)!=0u) color*=cellTint(hit.cell);
    return color;
}
vec3 hitAlbedo(Hit hit, vec3 point) { return (hit.material&255u)==3u ? hit.albedo : cubeAlbedo(hit,point); }
// Vanilla's light-level curve: response(15)=1, response(0)=0.
float lightResponse(float level) { float value=clamp(level,0.0,15.0)/15.0; return value/(4.0-3.0*value); }
// Display sky color decoded to linear, used as uniform sky radiance (pi-normalized irradiance units).
vec3 skyRadiance() { return environment.values[2].rgb*(environment.values[2].w*environment.values[1].w); }
vec3 blockColor() { return environment.values[3].rgb*environment.values[3].w; }
struct CellLight { bool available; float block; float sky; ivec3 cell; };
// Incident light lies outside the visible surface, not inside an opaque cube.
CellLight lightOutside(vec3 point, vec3 normal) {
    ivec3 cell=ivec3(floor(point+normal*0.003));
    uint light=cellValue(cell);
    bool available=light!=0xffffffffu && (light&(1u<<28))!=0u;
    return CellLight(available,available ? float((light>>16)&15u) : 0.0,available ? float((light>>20)&15u) : 0.0,cell);
}
uint emissionLevel(Hit hit) { return max(uint(hit.emission*15.0+0.5),(hit.material>>24)&15u); }
// Opaque blocker search; translucent layers filter by their coverage-weighted color.
Hit traceOpaque(vec3 origin, vec3 direction, float maxT, out vec3 filterColor) {
    filterColor=vec3(1);
    float nearT=0.001;
    for (int layer=0; layer<8; layer++) {
        Hit blocker=trace(origin,direction,nearT,maxT);
        if (!blocker.found || (blocker.flags&FLAG_TRANSLUCENT)==0u) return blocker;
        filterColor*=mix(vec3(1),blocker.albedo,blocker.alpha);
        nearT=max(nearT,blocker.t)+0.0005;
    }
    filterColor=vec3(0); // explicit layer budget: beyond it nothing is transmitted
    return miss();
}
// Direct Sun/Moon irradiance from one cone sample. Rays leaving the bounded grid are scaled by the
// vanilla sky-light response, which removes the key light in caves deeper than the grid.
vec3 keyIrradiance(vec3 point, vec3 normal, float skyResponse, inout uint seed) {
    vec3 key=environment.values[0].xyz;
    float square=dot(key,key);
