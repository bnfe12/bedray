vec2 octEncode(vec3 n) {
    float sum=abs(n.x)+abs(n.y)+abs(n.z);
    if (sum<1e-6) return vec2(0);
    n/=sum;
    vec2 e=n.xy;
    if (n.z<0.0) e=(vec2(1.0)-abs(n.yx))*vec2(n.x>=0.0 ? 1.0 : -1.0,n.y>=0.0 ? 1.0 : -1.0);
    return e;
}
vec3 octDecode(vec2 e) {
    vec3 n=vec3(e,1.0-abs(e.x)-abs(e.y));
    float t=max(-n.z,0.0);
    n.x+=n.x>=0.0 ? -t : t;
    n.y+=n.y>=0.0 ? -t : t;
    return normalize(n);
}
