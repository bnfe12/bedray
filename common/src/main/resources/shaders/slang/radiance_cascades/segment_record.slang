// Typed interval atlas record access.
//
// This module owns whole-record reads, writes and the two-segment ray
// composition.  It knows the canonical layout and the RCSegment validity rules;
// it does not own probe reconstruction (see probe_resolve.slang) and it never
// touches the legacy float4 atlas.
//
// All operations are whole-record accesses and require the caller to
// synchronize readers and writers.  The two writes of rcWriteRaySegments are
// not atomic as a pair; readers need a pass barrier.
//
// The read helpers are generic over IRCSegmentSource so the read-only and
// writable buffer flavours share one implementation.  A writable atlas is a
// legitimate read source: a pass that owns the atlas does not need a second
// read-only binding just to compose a ray.

public module segment_record;

import "radiance_cascades.slang";
__exported import "radiance_cascades/rc_atlas_layout.slang";
__exported import "radiance_cascades/interval_transport.slang";

// One read surface over a typed atlas.  The two implementations below are the
// only buffer flavours the store supports; a caller never passes a raw buffer
// through a type-erased path.
interface IRCSegmentSource {
    RCSegment rcLoadSegment(uint index);
}

struct RCReadOnlySegmentSource : IRCSegmentSource {
    StructuredBuffer<RCSegment> records;
    RCSegment rcLoadSegment(uint index) { return records[index]; }
}

struct RCReadWriteSegmentSource : IRCSegmentSource {
    RWStructuredBuffer<RCSegment> records;
    RCSegment rcLoadSegment(uint index) { return records[index]; }
}

// capacity is the number of RCSegment elements in the bound descriptor range,
// not bytes or the allocation's full size.  The host must validate the reflected
// record stride and descriptor range before dispatch.  The canonical layout is
// generated by radianceCascadeLayout(); a fabricated layout is rejected here
// before any record is read or written.
bool rcSegmentIndex(RadianceCascadeLayout layout, uint capacity, uint cascade,
                    uint probeIndex, uint rayIndex, uint interval, out uint index) {
    index = RC_INVALID_RECORD;
    if (!rcLayoutCanonical(layout, capacity)) return false;
    if (cascade >= RADIANCE_CASCADE_COUNT) return false;
    if (probeIndex >= layout.probeCount[cascade] ||
        rayIndex >= layout.rayCount[cascade] ||
        interval >= RC_INTERVALS_PER_RAY) return false;

    uint candidate = rcUncheckedIntervalIndex(layout, cascade, probeIndex, rayIndex, interval);
    if (candidate == RC_INVALID_RECORD || candidate >= layout.totalRecords) return false;
    index = candidate;
    return true;
}

RCSegment rcReadSegmentFrom<T : IRCSegmentSource>(T source, RadianceCascadeLayout layout,
        uint capacity, uint cascade, uint probeIndex, uint rayIndex, uint interval) {
    uint index;
    if (!rcSegmentIndex(layout, capacity, cascade, probeIndex, rayIndex, interval, index))
        return rcUnresolvedSegment();
    return source.rcLoadSegment(index);
}

RCSegment rcReadSegment(StructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                        uint capacity, uint cascade, uint probeIndex, uint rayIndex, uint interval) {
    RCReadOnlySegmentSource source;
    source.records = records;
    return rcReadSegmentFrom(source, layout, capacity, cascade, probeIndex, rayIndex, interval);
}

RCSegment rcReadSegment(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                        uint capacity, uint cascade, uint probeIndex, uint rayIndex, uint interval) {
    RCReadWriteSegmentSource source;
    source.records = records;
    return rcReadSegmentFrom(source, layout, capacity, cascade, probeIndex, rayIndex, interval);
}

// The caller owns the record exclusively until the write is visible.  Invalid
// input is normalized to unresolved and returns false, never left as stale
// history.  The truncated diagnostic is retained; radiance and T are cleared.
bool rcWriteSegment(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                    uint capacity, uint cascade, uint probeIndex, uint rayIndex,
                    uint interval, RCSegment segment) {
    uint index;
    if (!rcSegmentIndex(layout, capacity, cascade, probeIndex, rayIndex, interval, index)) return false;
    if (!rcSegmentValid(segment)) {
        records[index] = rcUnresolvedWithDiagnostics(segment.flags);
        return false;
    }
    records[index] = segment;
    return true;
}

bool rcClearSegment(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                    uint capacity, uint cascade, uint probeIndex, uint rayIndex, uint interval) {
    uint index;
    if (!rcSegmentIndex(layout, capacity, cascade, probeIndex, rayIndex, interval, index)) return false;
    records[index] = rcUnresolvedSegment();
    return true;
}

// One invocation owns both records.  Resolve both addresses before writing so
// an invalid address cannot leave half of a previous ray paired with new data.
// Invalid segments are normalized separately: an opaque valid front segment can
// still be useful even when the back was not traced.  A true return means that
// both addresses were written, not that the resulting ray is resolved.  These
// two stores are not atomic as a pair; readers must wait for the pass barrier.
bool rcWriteRaySegments(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                        uint capacity, uint cascade, uint probeIndex, uint rayIndex,
                        RCSegment front, RCSegment back) {
    // Validate the layout once for both records.  rcUncheckedIntervalIndex
    // still checks every address component; it only skips the repeated
    // canonical-layout comparison.
    if (!rcLayoutCanonical(layout, capacity)) return false;
    uint frontIndex = rcUncheckedIntervalIndex(layout, cascade, probeIndex, rayIndex,
        RC_INTERVAL_NEAR);
    uint backIndex = rcUncheckedIntervalIndex(layout, cascade, probeIndex, rayIndex,
        RC_INTERVAL_FAR);
    if (frontIndex == RC_INVALID_RECORD || backIndex == RC_INVALID_RECORD) return false;
    if (!rcSegmentValid(front)) front = rcUnresolvedWithDiagnostics(front.flags);
    if (!rcSegmentValid(back)) back = rcUnresolvedWithDiagnostics(back.flags);
    records[frontIndex] = front;
    records[backIndex] = back;
    return true;
}

bool rcClearRaySegments(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                        uint capacity, uint cascade, uint probeIndex, uint rayIndex) {
    return rcWriteRaySegments(records, layout, capacity, cascade, probeIndex, rayIndex,
                              rcUnresolvedSegment(), rcUnresolvedSegment());
}

// Resolves only the two consecutive segments of one ray, not different
// cascades or different probe positions.  An incomplete back segment stays
// unresolved unless the front segment is exactly opaque.  The layout is
// validated once, not once per record.
RCSegment rcResolveRayFrom<T : IRCSegmentSource>(T source, RadianceCascadeLayout layout,
        uint capacity, uint cascade, uint probeIndex, uint rayIndex) {
    if (!rcLayoutCanonical(layout, capacity)) return rcUnresolvedSegment();
    if (cascade >= RADIANCE_CASCADE_COUNT ||
        probeIndex >= layout.probeCount[cascade] ||
        rayIndex >= layout.rayCount[cascade]) return rcUnresolvedSegment();

    uint nearIndex = rcUncheckedIntervalIndex(layout, cascade, probeIndex, rayIndex, 0u);
    uint farIndex = rcUncheckedIntervalIndex(layout, cascade, probeIndex, rayIndex, 1u);
    return rcComposeSegments(source.rcLoadSegment(nearIndex), source.rcLoadSegment(farIndex));
}

RCSegment rcResolveRay(StructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                       uint capacity, uint cascade, uint probeIndex, uint rayIndex) {
    RCReadOnlySegmentSource source;
    source.records = records;
    return rcResolveRayFrom(source, layout, capacity, cascade, probeIndex, rayIndex);
}

RCSegment rcResolveRay(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                       uint capacity, uint cascade, uint probeIndex, uint rayIndex) {
    RCReadWriteSegmentSource source;
    source.records = records;
    return rcResolveRayFrom(source, layout, capacity, cascade, probeIndex, rayIndex);
}
