// Typed interval atlas. This is a separate format from the old float4 atlas;
// binding one format as the other is invalid. All operations are whole-record
// accesses and require the caller to synchronize readers and writers.
public module segment_store;

import "radiance_cascades.slang";
import "radiance_cascades/radiance_cascades_store.slang";
import "radiance_cascades/interval_transport.slang";

// capacity is the number of RCSegment elements in the bound descriptor range,
// not bytes or the allocation's full size. The host must validate the reflected
// record stride and descriptor range before dispatch. The canonical layout is
// generated by radianceCascadeLayout(); fabricated layouts are not accepted.
bool rcSegmentIndex(RadianceCascadeLayout layout, uint capacity, uint cascade,
                    uint probeIndex, uint rayIndex, uint interval, out uint index) {
    index = RC_INVALID_RECORD;
    if (layout.cascadeCount != RADIANCE_CASCADE_COUNT ||
        layout.intervalsPerRay != RC_INTERVALS_PER_RAY ||
        layout.totalRecords > capacity) return false;
    if (cascade >= RADIANCE_CASCADE_COUNT) return false;
    RadianceCascadeLayout expected = radianceCascadeLayout();
    if (layout.totalRecords != expected.totalRecords ||
        layout.baseOffset[cascade] != expected.baseOffset[cascade] ||
        layout.probeCount[cascade] != expected.probeCount[cascade] ||
        layout.rayCount[cascade] != expected.rayCount[cascade] ||
        layout.probeAxis[cascade] != expected.probeAxis[cascade]) return false;
    uint candidate = rcIntervalIndex(layout, cascade, probeIndex, rayIndex, interval);
    if (candidate == RC_INVALID_RECORD || candidate >= layout.totalRecords || candidate >= capacity) return false;
    index = candidate;
    return true;
}

RCSegment rcReadSegment(StructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                        uint capacity, uint cascade, uint probeIndex, uint rayIndex, uint interval) {
    uint index;
    if (!rcSegmentIndex(layout, capacity, cascade, probeIndex, rayIndex, interval, index))
        return rcUnresolvedSegment();
    return records[index];
}

RCSegment rcReadSegment(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                        uint capacity, uint cascade, uint probeIndex, uint rayIndex, uint interval) {
    uint index;
    if (!rcSegmentIndex(layout, capacity, cascade, probeIndex, rayIndex, interval, index))
        return rcUnresolvedSegment();
    return records[index];
}

// The caller owns the record exclusively until the write is visible. Invalid
// input is normalized to unresolved and returns false, never left as stale
// history. The truncated diagnostic is retained; radiance and T are cleared.
bool rcWriteSegment(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                    uint capacity, uint cascade, uint probeIndex, uint rayIndex,
                    uint interval, RCSegment segment) {
    uint index;
    if (!rcSegmentIndex(layout, capacity, cascade, probeIndex, rayIndex, interval, index)) return false;
    if (!rcSegmentValid(segment)) {
        records[index] = rcUnresolvedWithDiagnostics(segment.flags);
        return false;
    }
    records[index] = segment;
    return true;
}

bool rcClearSegment(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                    uint capacity, uint cascade, uint probeIndex, uint rayIndex, uint interval) {
    uint index;
    if (!rcSegmentIndex(layout, capacity, cascade, probeIndex, rayIndex, interval, index)) return false;
    records[index] = rcUnresolvedSegment();
    return true;
}

// One invocation owns both records. Resolve both addresses before writing so
// an invalid address cannot leave half of a previous ray paired with new data.
// Invalid segments are normalized separately: an opaque valid front segment can
// still be useful even when the back was not traced. A true return means that
// both addresses were written, not that the resulting ray is resolved. These
// two stores are not atomic as a pair; readers must wait for the pass barrier.
bool rcWriteRaySegments(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                        uint capacity, uint cascade, uint probeIndex, uint rayIndex,
                        RCSegment front, RCSegment back) {
    uint frontIndex;
    uint backIndex;
    if (!rcSegmentIndex(layout, capacity, cascade, probeIndex, rayIndex, 0u, frontIndex) ||
        !rcSegmentIndex(layout, capacity, cascade, probeIndex, rayIndex, 1u, backIndex)) return false;
    if (!rcSegmentValid(front)) front = rcUnresolvedWithDiagnostics(front.flags);
    if (!rcSegmentValid(back)) back = rcUnresolvedWithDiagnostics(back.flags);
    records[frontIndex] = front;
    records[backIndex] = back;
    return true;
}

bool rcClearRaySegments(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                        uint capacity, uint cascade, uint probeIndex, uint rayIndex) {
    return rcWriteRaySegments(records, layout, capacity, cascade, probeIndex, rayIndex,
                              rcUnresolvedSegment(), rcUnresolvedSegment());
}

// Resolves only the two consecutive segments of one ray, not different
// cascades or different probe positions. An incomplete back segment stays
// unresolved unless the front segment is exactly opaque.
RCSegment rcResolveRay(StructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                       uint capacity, uint cascade, uint probeIndex, uint rayIndex) {
    RCSegment front = rcReadSegment(records, layout, capacity, cascade, probeIndex, rayIndex, 0u);
    RCSegment back = rcReadSegment(records, layout, capacity, cascade, probeIndex, rayIndex, 1u);
    return rcComposeSegments(front, back);
}

RCSegment rcResolveRay(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
                       uint capacity, uint cascade, uint probeIndex, uint rayIndex) {
    RCSegment front = rcReadSegment(records, layout, capacity, cascade, probeIndex, rayIndex, 0u);
    RCSegment back = rcReadSegment(records, layout, capacity, cascade, probeIndex, rayIndex, 1u);
    return rcComposeSegments(front, back);
}

// ---- Typed probe resolve ----------------------------------------------------
//
// Reconstructs a cosine-weighted average radiance for a shading normal from the
// typed atlas.  Each ray contributes the radiance of its composed near/far
// transport (`rcComposeSegments`), never a confidence-weighted average of the
// two records: confidence is validity metadata, and an opaque near interval
// must extinguish the far one regardless of how confident either sample is.
// Rays whose composition is unresolved are skipped.  A caller that must know
// whether the probe was complete uses rcProbeComplete; a caller that needs
// distance-dependent GI resolves the individual rays with rcResolveRay.
//
// This resolves one probe's two intervals per ray.  It does not interpolate
// across cascades or probe positions; that mapping belongs to the integration.
float3 rcProbeIrradiance(StructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
        uint capacity, uint cascade, uint probeIndex, float3 normal, uint rotation) {
    if (cascade >= RADIANCE_CASCADE_COUNT) return float3(0.0);

    float normalLengthSquared = dot(normal, normal);
    if (!(normalLengthSquared > 0.0) || !isfinite(normalLengthSquared)) return float3(0.0);
    float3 unitNormal = normalize(normal);

    RadianceCascadeDesc desc = radianceCascade(cascade);
    float3 sum = float3(0.0);
    float weightSum = 0.0;

    for (uint ray = 0u; ray < desc.rayCount; ++ray) {
        float3 direction = cascadeDirection(ray, desc.rayCount, rotation);
        float cosine = max(dot(unitNormal, direction), 0.0);
        if (cosine <= 0.0) continue;

        RCSegment segment = rcResolveRay(records, layout, capacity, cascade, probeIndex, ray);
        if (!rcSegmentValid(segment)) continue;

        sum += segment.radiance * cosine;
        weightSum += cosine;
    }

    return sum / max(weightSum, 1.0e-6);
}

// Writable-buffer overload: a pass that owns the atlas does not need a second
// read-only binding just to reconstruct irradiance.
float3 rcProbeIrradiance(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
        uint capacity, uint cascade, uint probeIndex, float3 normal, uint rotation) {
    if (cascade >= RADIANCE_CASCADE_COUNT) return float3(0.0);

    float normalLengthSquared = dot(normal, normal);
    if (!(normalLengthSquared > 0.0) || !isfinite(normalLengthSquared)) return float3(0.0);
    float3 unitNormal = normalize(normal);

    RadianceCascadeDesc desc = radianceCascade(cascade);
    float3 sum = float3(0.0);
    float weightSum = 0.0;

    for (uint ray = 0u; ray < desc.rayCount; ++ray) {
        float3 direction = cascadeDirection(ray, desc.rayCount, rotation);
        float cosine = max(dot(unitNormal, direction), 0.0);
        if (cosine <= 0.0) continue;

        RCSegment segment = rcResolveRay(records, layout, capacity, cascade, probeIndex, ray);
        if (!rcSegmentValid(segment)) continue;

        sum += segment.radiance * cosine;
        weightSum += cosine;
    }

    return sum / max(weightSum, 1.0e-6);
}

// A probe is complete only when every ray composes to a valid segment.  An
// exactly opaque front segment is complete without a back sample; a
// transmissive front with an unresolved back is not.  rcSegmentIndex validates
// the canonical layout and capacity, so an invalid layout fails the first ray
// instead of reading outside the descriptor range.
bool rcProbeComplete(StructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
        uint capacity, uint cascade, uint probeIndex) {
    if (cascade >= RADIANCE_CASCADE_COUNT) return false;

    RadianceCascadeDesc desc = radianceCascade(cascade);
    for (uint ray = 0u; ray < desc.rayCount; ++ray) {
        RCSegment segment = rcResolveRay(records, layout, capacity, cascade, probeIndex, ray);
        if (!rcSegmentValid(segment)) return false;
    }
    return true;
}

bool rcProbeComplete(RWStructuredBuffer<RCSegment> records, RadianceCascadeLayout layout,
        uint capacity, uint cascade, uint probeIndex) {
    if (cascade >= RADIANCE_CASCADE_COUNT) return false;

    RadianceCascadeDesc desc = radianceCascade(cascade);
    for (uint ray = 0u; ray < desc.rayCount; ++ray) {
        RCSegment segment = rcResolveRay(records, layout, capacity, cascade, probeIndex, ray);
        if (!rcSegmentValid(segment)) return false;
    }
    return true;
}
