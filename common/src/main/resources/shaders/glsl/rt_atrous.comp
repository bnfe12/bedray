#version 460
// Spatial a-trous filter of the demodulated irradiance for pixels whose temporal history is still short (SVGF-style, Schied et al.
// 2017, "Spatiotemporal Variance-Guided Filtering"): runs after rt_rays.comp with VKB_ACCUM, 3 iterations (step 1, 2, 4) of the 5x5
// B3-spline kernel over the irradiance in the accumulation image (rows [cur*H, +H): rgb mean irradiance, a = history length n).
// Edge stopping: hit distance (plane tolerance as in the history test), normal, and luminance scaled by the local variance
// (estimated from the 3x3 neighbourhood in iteration 0 and filtered along). The filtered irradiance is blended with the unfiltered
// one by (1 - n / FILTER_FULL_N), so converged pixels (n >= FILTER_FULL_N) and all texture detail stay untouched: the pass only
// removes the noise of new / disoccluded / changed pixels and of the first frames after a reset. The final iteration re-lights the
// pixel exactly as rt_rays.comp does: finishColor(irradiance * albedo + rest): albedo in band 4 (rows [4H,5H)), rest R (specular, emission, fog, glass;
// never filtered or divided by an albedo) in rows [(7+cur)H, +H).
// Scratch rows: [5H,6H) and [6H,7H) (rgb irradiance, a variance). The iteration is passed in params2 bits 16-19 (count in 20-23).
#include "rt_common.glsl"

const float FILTER_FULL_N = 24.0;

float lum(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 size = imageSize(outImage);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    int H = size.y;
    int cur = int(pc.frame & 1u);
    uint it = (params2() >> 16u) & 15u;
    uint iters = (params2() >> 20u) & 15u;
    int srcRow = it == 0u ? cur * H : (5 + int((it - 1u) & 1u)) * H;
    int dstRow = (5 + int(it & 1u)) * H;
    int stride = 1 << int(it);

    vec4 band = imageLoad(accumImage, ivec2(p.x, p.y + 4 * H));
    vec4 gC = imageLoad(accumImage, ivec2(p.x, p.y + (2 + cur) * H));
    vec4 hC = imageLoad(accumImage, ivec2(p.x, p.y + cur * H));
    vec4 sC = imageLoad(accumImage, ivec2(p.x, p.y + srcRow));
    float n = hC.a;
    bool live = band.w > 0.5 && gC.w > 0.0 && n < FILTER_FULL_N;

    vec3 res = sC.rgb;
    float resVar = it == 0u ? 0.0 : sC.a;
    if (live) {
        vec3 nC = gC.xyz;
        float dC = gC.w;
        vec2 camJitter = getCameraJitter();
        vec3 rayDir = cameraRay(p, size, vec2(0.5) + camJitter);
        vec4 c0 = pc.invViewProj * vec4(0.0, 0.0, 0.5, 1.0);
        vec4 c1 = pc.invViewProj * vec4(0.0, 2.0 / float(size.y), 0.5, 1.0);
        // Same guard rt_common_temporal.glsl uses for the screen-space angle: a degenerate invViewProj (zero or infinite w)
        // would make pixAngle NaN, and NaN propagates into every neighbour test below, so the whole filter collapses at once.
        float pixAngle = length(normalizeOr(c1.xyz / safeW(c1.w), rawCameraForward())
            - normalizeOr(c0.xyz / safeW(c0.w), rawCameraForward()));
        float cosInc = max(abs(dot(rayDir, nC)), 0.08);
        float lumC = lum(sC.rgb);

        // Iterations > 0 inherit the variance written by the previous one: a NaN or out-of-range value there must not widen
        // sigmaL to Inf (which would silently drop the luminance test for every neighbour).
        float varC = sC.a >= 0.0 && sC.a <= 1.0e6 ? sC.a : 0.0;
        if (it == 0u) {
            // spatial variance of the noisy irradiance (3x3, same surface only)
            float m1 = 0.0;
            float m2 = 0.0;
            float mw = 0.0;
            for (int j = -1; j <= 1; j++) {
                for (int i = -1; i <= 1; i++) {
                    ivec2 q = p + ivec2(i, j);
                    if (q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y) {
                        continue;
                    }
                    vec4 gq = imageLoad(accumImage, ivec2(q.x, q.y + (2 + cur) * H));
                    if (gq.w <= 0.0 || abs(gq.w - dC) > 0.02 * dC + 0.05 + 1.5 * dC * pixAngle * 1.5 / cosInc || dot(gq.xyz, nC) < 0.9) {
                        continue;
                    }
                    float l = lum(imageLoad(accumImage, ivec2(q.x, q.y + cur * H)).rgb);
                    m1 += l;
                    m2 += l * l;
                    mw += 1.0;
                }
            }
            m1 /= max(mw, 1.0);
            m2 /= max(mw, 1.0);
            float varEst = m2 - m1 * m1;
            varC = (isnan(varEst) || isinf(varEst)) ? 0.0 : min(max(varEst, 0.0), 1.0e6);
        }
        float sigmaL = 4.0 * sqrt(max(varC, 0.0)) + 1.0e-3;

        const float k[5] = float[5](1.0 / 16.0, 1.0 / 4.0, 3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);
        vec3 sum = vec3(0.0);
        float sumVar = 0.0;
        float sumW = 0.0;
        for (int j = -2; j <= 2; j++) {
            for (int i = -2; i <= 2; i++) {
                ivec2 q = p + ivec2(i, j) * stride;
                if (q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y) {
                    continue;
                }
                float w = k[i + 2] * k[j + 2];
                vec4 sq;
                if (i == 0 && j == 0) {
                    sq = sC;
                } else {
                    vec4 gq = imageLoad(accumImage, ivec2(q.x, q.y + (2 + cur) * H));
                    float offPx = length(vec2(i, j) * float(stride));
                    float tolZ = 0.02 * dC + 0.05 + 1.5 * dC * pixAngle * offPx / cosInc;
                    if (gq.w <= 0.0 || abs(gq.w - dC) > tolZ) {
                        continue;
                    }
                    float dn = dot(gq.xyz, nC);
                    if (dn < 0.5) {
                        continue;
                    }
                    w *= pow(dn, 24.0);
                    sq = imageLoad(accumImage, ivec2(q.x, q.y + srcRow));
                    w *= exp(-abs(lum(sq.rgb) - lumC) / sigmaL);
                }
                float vq = it == 0u ? varC : (i == 0 && j == 0 ? sC.a : sq.a);
                // A non-finite sample or weight (Inf - Inf luminance between two saturated pixels) would poison the whole
                // neighbourhood sum, so drop that tap instead; NaN fails every comparison, hence the "not greater" form.
                if (!(w > 0.0) || any(isnan(sq.rgb)) || any(isinf(sq.rgb))) {
                    continue;
                }
                vq = vq >= 0.0 && vq <= 1.0e6 ? vq : 0.0;
                sum += w * sq.rgb;
                sumVar += w * w * vq;
                sumW += w;
            }
        }
        float strength = clamp((FILTER_FULL_N - n) / FILTER_FULL_N, 0.0, 1.0);
        vec3 filtered = sum / max(sumW, 1.0e-6);
        res = mix(sC.rgb, filtered, strength);
        resVar = sumVar / max(sumW * sumW, 1.0e-6);
    }
    // Last line of defence: the scratch rows written here become the history the next iterations and frames filter, so a single
    // NaN would persist and spread screen-wide rather than costing one pixel. Black self-heals once rt_rays writes a finite value.
    if (any(isnan(res)) || any(isinf(res))) {
        res = vec3(0.0);
    }
    resVar = (isnan(resVar) || isinf(resVar)) ? 0.0 : min(resVar, 1.0e6);
    imageStore(accumImage, ivec2(p.x, p.y + dstRow), vec4(res, resVar));
    if (live && it + 1u == iters) {
        vec3 rest = imageLoad(accumImage, ivec2(p.x, p.y + (7 + cur) * H)).rgb;   // reflections, emission, fog: not filtered here
        // clamp() of a NaN is undefined, and this is the image the upscaler consumes: an infinite rest band would smear the
        // whole reconstructed frame rather than lose the reflection of one pixel.
        if (any(isnan(rest)) || any(isinf(rest))) {
            rest = vec3(0.0);
        }
        // The albedo band is multiplied into the filtered radiance below, so it poisons the pixel exactly like `rest` would.
        // It reaches here straight from the G-buffer store (rt_common_temporal.glsl writes it without going through the
        // radiance guards), and a non-finite albedo is one multiply away from the undefined clamp(NaN).
        if (any(isnan(band.rgb)) || any(isinf(band.rgb))) {
            band.rgb = vec3(0.0);
        }
        imageStore(outImage, p, vec4(clamp(finishColor(res * band.rgb + rest), 0.0, 1.0), 1.0));
    }
}
