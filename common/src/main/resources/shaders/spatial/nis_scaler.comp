#version 450
// NVIDIA Image Scaling (NIS) NVScaler pass. Host file of this mod; the algorithm is NVIDIA NIS_Scaler.h v1.0.3 (MIT),
// appended by SpatialShaderSource with three checked text patches (see SpatialShaderSource.nisSource):
//  - the two coefficient texture loads read the GLSL constant arrays generated from NIS_Config.h instead of textures,
//  - the output store is bounds-checked (NIS writes whole 32x24 blocks; the window size is not a multiple of the block).
// Bindings follow NIS_Main.hlsl (sampler, input, output); the 112-byte constant block is the NISConfig struct of
// NIS_Config.h as push constants (filled by NisConstants.java, a port of NVScalerUpdateConfig).

#define NIS_HLSL 0
#define NIS_HLSL_6_2 0
#define NIS_GLSL 1
#define NIS_SCALER 1
#define NIS_USE_HALF_PRECISION 0
#define NIS_BLOCK_WIDTH 32
#define NIS_BLOCK_HEIGHT 24
// 128 = the Vulkan minimum of maxComputeWorkGroupInvocations and NISOptimizer's value for NVIDIA_Generic.
#define NIS_THREAD_GROUP_SIZE 128

layout(local_size_x = NIS_THREAD_GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform NisConstants {
    float kDetectRatio;
    float kDetectThres;
    float kMinContrastRatio;
    float kRatioNorm;

    float kContrastBoost;
    float kEps;
    float kSharpStartY;
    float kSharpScaleY;

    float kSharpStrengthMin;
    float kSharpStrengthScale;
    float kSharpLimitMin;
    float kSharpLimitScale;

    float kScaleX;
    float kScaleY;

    float kDstNormX;
    float kDstNormY;
    float kSrcNormX;
    float kSrcNormY;

    uint kInputViewportOriginX;
    uint kInputViewportOriginY;
    uint kInputViewportWidth;
    uint kInputViewportHeight;

    uint kOutputViewportOriginX;
    uint kOutputViewportOriginY;
    uint kOutputViewportWidth;
    uint kOutputViewportHeight;

    float reserved0;
    float reserved1;
};

layout(binding = 0) uniform sampler samplerLinearClamp;
layout(binding = 1) uniform texture2D in_texture;
layout(binding = 2, rgba8) uniform writeonly image2D out_texture;

//@@NIS_COEFFICIENTS@@
//@@NIS_SCALER@@

void main() {
    NVScaler(gl_WorkGroupID.xy, gl_LocalInvocationID.x);
}
