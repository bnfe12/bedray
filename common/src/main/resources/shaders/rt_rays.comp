#version 460
// Ray Tracing mode (RtRayEffectsPass): primary rays from the camera through the TLAS of Sodium section BLASes and entity BLASes
// (mask 0x03: MASK_WORLD | MASK_ENTITIES), block atlas albedo, alpha-tested cutout, procedural sky, plus ray traced effects,
// each switched by its own flag with its own rays per pixel (params2 nibbles) and distance (frame slot):
//  - sun/moon shadows: hard (one ray) or soft (rays jittered inside a widened sun cone);
//  - ambient occlusion (cosine rays inside the AO radius) of the vanilla sky-light ambient;
//  - emissive lighting: self glow + next event estimation over the emitter list (RIS, one shadow ray per sample);
//  - one-bounce global illumination: cosine rays, the hit is shaded with sun + shadow, vanilla ambient and emission (replaces
//    the vanilla sky-light ambient);
//  - reflections: GGX VNDF sampled rays weighted by F(V.H) * G2/G1, energy-conserving diffuse/specular split, metals
//    tinted by their albedo and without diffuse exitance;
//  - temporal accumulation of all of it while the camera and the scene stand still (VKB_ACCUM, RtAccumulation).
// Scene access lives in rt_common.glsl.
#include "rt_common.glsl"


uint shadowRays() { return max(1u, params2() & 15u); }
uint emissiveRays() { return max(1u, (params2() >> 4u) & 15u); }
uint giRays() { return max(1u, (params2() >> 8u) & 15u); }
uint reflectionRays() { return max(1u, (params2() >> 12u) & 15u); }
float giDistance() { return StatsBuf(pc.statsAddr).giDist; }
float emissiveDistance() { return StatsBuf(pc.statsAddr).emisDist; }
float aoRadius() { return StatsBuf(pc.statsAddr).aoRadius; }

// Secondary rays (reflection / GI) pass interfaces deterministically and are shaded by rt_common.glsl shadeSimple.
bool traceSecondary(vec3 origin, vec3 dir, float reach, inout uint seed, out Surface hitSurface, out vec3 hitFilter) {
    return traceThroughInterfaces(origin, dir, reach, hitSurface, hitFilter);
}

vec3 shadeSecondary(Surface s, vec3 dir) {
    return shadeSimple(s, dir, hasFlag(FLAG_SHADOWS));
}

vec3 shadeSecondary(Surface s) {
    return shadeSimple(s, vec3(0.0), hasFlag(FLAG_SHADOWS));
}

// ---- Camera path through the interfaces in front of the shaded surface -----------------------------------------------------
// A glass block is two faces and a window several panes, and the camera ray used one closest-hit traversal per face: a
// stained-glass window six faces deep paid six full TLAS traversals for the single most numerous ray of the frame, and each
// pane tints it (the owner: "работа с цветными стёклами, которые красят лучи" — the worst drop). A pane never bends the ray,
// so the camera ray classifies the interfaces from the candidates exactly like the secondary walk (traceThroughInterfacesM)
// and crosses them all in ONE query; only the work per layer differs, because the camera adds the mirror of each interface
// and its tint (instead of folding a filter). Realistic-style water is the one interface that bends the ray (Snell): the walk
// stops there and the caller refracts and re-enters it.
struct CameraPath {
    vec3 thr;           // throughput behind the interfaces crossed so far
    vec3 glassRefl;     // mirror light of those interfaces, already weighted by F and thr
    WaterMedium med;    // water body the ray is in
    float firstDist;    // distance of the first surface the ray met (outDepth reports the interface, as the per-face walk did)
    bool hadFirst;
    uint interfaces;    // interfaces crossed, for the mirror gate
    uint mirrors;
    bool sawWater;
};

void cameraPathStart(out CameraPath cp, WaterMedium camMed) {
    cp.thr = vec3(1.0);
    cp.glassRefl = vec3(0.0);
    cp.med = camMed;
    cp.firstDist = 1.0e6;
    cp.hadFirst = false;
    cp.interfaces = 0u;
    cp.mirrors = 0u;
    cp.sawWater = camMed.inside;
}

// What one interface does to the camera ray, minus the bend: the mirror with its Fresnel weight, the vanilla water sheet
// colour, and the transmittance of the layer. Returns true for a realistic water face, which the caller refracts through.
bool cameraInterface(Surface s, vec3 rayDir, inout CameraPath cp, inout uint seed) {
    float F = interfaceReflectance(s, rayDir);
    bool volume = s.isWater && waterVolumeStyle() && isWaterBoundary(s);
    // Which interfaces pay for a mirror ray. The camera-facing interface keeps its mirror, and so does a water face seen behind
    // glass in either style, because that reflection is the whole look of the water. The mirror of a back face or of a pane
    // behind a pane carries 2..8 % of the light, and each mirror is a full mirrorRadianceM with a shadow, an AO, a sky and an
    // emitter ray: sampling all of them doubled the whole secondary cost of every stained-glass pixel.
    if (hasFlag(FLAG_REFLECTIONS) && cp.mirrors < 2u && (cp.interfaces == 0u || s.isWater)) {
        cp.mirrors++;
        vec3 rdir = bendHorizon(reflect(rayDir, s.ns), s.ng);
        if (volume && s.roughness > 0.03) {
            rdir = bendHorizon(coneAround(rdir, s.roughness * s.roughness, seed), s.ng);   // far sheen: waves below the pixel
        }
        vec3 refl = interfaceMirror(volume && F < 0.05, offsetOrigin(s), rdir, rayDistance(), hasFlag(FLAG_SHADOWS), cp.med);
        cp.glassRefl += cp.thr * F * refl;
    }
    cp.interfaces++;
    if (s.isWater && !volume) {
        // vanilla style: the animated water sprite (biome tint) is blended over the scene behind it
        cp.glassRefl += cp.thr * ((1.0 - F) * VANILLA_WATER_ALPHA) * vanillaWaterSurface(s, rayDir, emissiveDistance(), seed);
        crossWaterBoundary(cp.med, s, rayDir);
        cp.sawWater = true;
    }
    cp.thr *= interfaceTransmittance(s, F);
    if (volume) {
        crossWaterBoundary(cp.med, s, rayDir);
        cp.sawWater = true;
    }
    return volume;
}

// One TLAS traversal from origin down to the surface the camera sees, folding every interface in front of it into cp. Returns
// false when there is nothing to shade: nothing hit (the scattering of the water behind the last layer is folded in) or no
// light left behind the layers. `bend` is set when the ray stopped on a realistic water face: the caller refracts there and
// calls the walk again.
// ASSUMPTION: the candidates of one ray query arrive front to back. The Vulkan spec leaves the order implementation defined,
// and every desktop driver walks its BVH front to back; traceThroughInterfacesM (rt_common_water.glsl) already depends on it
// for every reflection and GI ray, so this walk does not add a new class of risk - but it does extend the assumption to the
// camera ray, where an out-of-order candidate would shade a farther surface and fold a pane behind it. Making it order
// independent would mean buffering the layers (they carry a mirror each) and keeping the query alive behind the nearest
// surface, which costs exactly the traversals this walk removes. `bend` is the one case where the walk does not need the
// order: a realistic water face always ends the segment, because the caller re-enters from it with a refracted direction.
bool cameraWalk(inout CameraPath cp, vec3 origin, vec3 dir, inout uint seed, out Surface s, out bool bend) {
    bend = false;
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0x03, origin, 0.001, dir, 4096.0);
    float lastT = 0.0;
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }
        uint slot = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false));
        uint geom = uint(rayQueryGetIntersectionGeometryIndexEXT(rq, false));
        uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
        float t = rayQueryGetIntersectionTEXT(rq, false);
        if (isSelfAvatarPrim(slot, prim)) {
            continue;   // the body of the first-person camera: a hit here is its own inside face
        }
        gHitT = t;
        // Camera classification (skipTranslucent = false): a cutout hole and a redstone dust texel below its coverage stay holes
        // and a visible dust texel stays a hit, exactly as the per-face walk classified them.
        if (!candidateAccepted(slot, geom, prim, bary, false)) {
            continue;
        }
        // The water column between the last layer and this candidate scatters towards the eye.
        if (cp.med.inside) {
            vec3 T;
            vec3 ins;
            waterSegment(cp.med, origin + dir * lastT, dir, max(t - lastT, 0.0), T, ins);
            cp.glassRefl += cp.thr * ins;
            cp.thr *= T;
        }
        lastT = max(t, lastT);
        Surface c;
        if (isEntityHit(slot)) {
            fetchEntitySurface(slot, geom, prim, bary, t, origin, dir, c);
        } else {
            fetchSurface(slot, geom, prim, bary, t, origin, dir, true, c);
        }
        if ((!c.translucent && c.alpha < 0.5) || c.alpha < 0.05) {
            continue;   // empty space of the quad (cutout hole, or a translucent texel the camera looks through): the ray passes
        }
        if (!cp.hadFirst) {
            cp.hadFirst = true;
            cp.firstDist = t;
        }
        s = c;
        if (!isInterface(c)) {
            return true;    // the surface the camera sees, with the exact position, normal and distance of the candidate
        }
        bend = cameraInterface(c, dir, cp, seed);
        if (bend) {
            return true;
        }
        if (max(cp.thr.r, max(cp.thr.g, cp.thr.b)) < 0.004) {
            return false;   // nothing is left of the light behind these layers (their mirror light stays), as the walk ended before
        }
        if (cp.interfaces >= 16u) {
            return true;    // 16 interfaces deep: the last pane is shaded as a surface, which is where the per-face walk ended up
        }
    }
    // The traversal ran out: a miss. The water the ray is still in scatters towards the eye for the next 48 blocks.
    if (cp.med.inside) {
        vec3 T;
        vec3 ins;
        waterSegment(cp.med, origin + dir * lastT, dir, clamp(4096.0 - lastT, 0.0, 48.0), T, ins);
        cp.glassRefl += cp.thr * ins;
        cp.thr *= T;
    }
    return false;
}

void main() {
    WaterMedium camMed = cameraWaterMediumShared(cameraOrigin());   // camera under water: one ray per subgroup
    ivec2 size = imageSize(outImage);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    uint mode = viewMode();
    vec2 camJitter = getCameraJitter();
    vec3 dir = cameraRay(p, size, vec2(0.5) + camJitter);
    uint seed = uint(p.x) * 1973u + uint(p.y) * 9277u + pc.frame * 26699u + 1u;

    Surface s;
    vec3 rayOrig = cameraOrigin();
    vec3 rayDir = dir;
    // Interfaces in front of the shaded surface (rt_common.glsl interface*): deterministic split, the mirror reflection of each
    // is added with weight F (glassRefl), the ray continues behind it with (1 - F) * tint. No random choice, so glass and water
    // do not flicker between "opaque" and "transparent" per pixel and frame. One traversal covers a whole straight run of the
    // ray (cameraWalk); a realistic water face bends it, so the walk is re-entered behind the Snell bend, at most a few times.
    CameraPath cp;
    cameraPathStart(cp, camMed);
    bool hit = false;
    for (uint bendIdx = 0u; bendIdx < 4u; bendIdx++) {
        bool bend = false;
        hit = cameraWalk(cp, rayOrig, rayDir, seed, s, bend);
        if (!bend) {
            break;
        }
        vec3 rd = refract(rayDir, s.ns, rayDir.y < 0.0 ? 1.0 / WATER_IOR : WATER_IOR);
        if (dot(rd, rd) <= 0.5) {
            cp.thr = vec3(0.0);   // total internal reflection: the mirror ray above carries the light
            hit = false;
            break;
        }
        rayDir = normalize(rd);   // Snell refraction through the wavy surface
        rayOrig = s.pos + rayDir * 0.002;
    }
    vec3 thr = cp.thr;
    vec3 glassRefl = cp.glassRefl;
    WaterMedium med = cp.med;
    bool sawWater = cp.sawWater;
    float firstDist = cp.firstDist;
    bool hadFirst = cp.hadFirst;
    vec3 color = vec3(0.0);            // the sky is only needed on a miss (display space, not tone mapped below)
    vec3 diffE = vec3(0.0);    // lit view: diffuse light reaching the eye (x thr), before the albedo
    bool tonemapped = false;   // lit / reflection views are tone mapped after the accumulation
    // distance fog / god rays are linear: out = T * color + A (rt_common.glsl atmosphereTransmittance).
    // Computed before the shading branch so the denoiser G-buffer channels carry the fog as well: the compose pass
    // (rt_pack_nrd.comp) rebuilds the exact final colour from them and never re-applies the atmosphere.
    float atmT = 1.0;
    vec3 atmA = vec3(0.0);
    gSectionFade = hit ? sectionFade(s.slot) : 0.0;
    if (mode == MODE_LIT || mode == MODE_REFLECTION || mode == MODE_GI || mode == MODE_ALBEDO || !hit) {
        atmA = applyVolumetricAtmosphere(vec3(0.0), vec3(0.0), dir, hit ? s.t : 1.0e6, hit);
        atmT = atmosphereTransmittance(vec3(0.0), dir, hit ? s.t : 1.0e6, hit);
    }
    if (hit) {
        float t = s.t;
        if (mode == MODE_NORMALS) {
            color = s.ns * 0.5 + 0.5;
        } else if (mode == MODE_DEPTH) {
            color = vec3(1.0 - clamp(t / 128.0, 0.0, 1.0));
        } else if (mode == MODE_UV) {
            color = vec3(fract(s.uv * 64.0), 0.25);
        } else if (mode == MODE_SECTION) {
            color = hashColor(s.slot);
        } else if (mode == MODE_ALBEDO) {
            color = s.albedo * thr;
        } else if (mode == MODE_SKY) {
            color = s.albedo * thr * 0.25;   // geometry dimmed; the sky with the sun/moon disk is drawn where nothing is hit
        } else if (mode == MODE_MATERIAL) {
            color = vec3(s.roughness, s.metal > 0.5 ? 1.0 : s.f0 * 4.0, s.emission);
        } else if (mode == MODE_EMISSION) {
            color = emitted(s) * thr;
        } else {
            vec3 o = offsetOrigin(s);
            vec3 L = pc.keyDir.xyz;
            bool underwater = med.inside && waterVolumeStyle();
            // Pixel shadows: every fragment of a world cell traces its sun ray from the same point, so the shadow edge
            // becomes a blocky staircase (rt_common_pixel_shadow.glsl owns the policy). Only the shadow ray moves: AO, GI
            // and reflections keep the exact surface origin, and a cell that crosses geometry keeps its exact shadow.
            bool cellShadow = hasFlag(FLAG_SHADOWS) && pixelShadowApplies(s, underwater);
            vec3 vis = vec3(0.0);
            vec3 uwOrigin = o;
            vec3 uwDir = L;
            vec3 uwGain = vec3(1.0);
            bool uwLit = true;
            if (underwater) {
                // sun under water: refracted shadow ray + absorption + Fresnel + analytic caustic (rt_common.glsl waterSunBeam)
                vec3 Lw;
                // A plant under water keeps one refracted sun direction of its own block: kelp and seagrass are foliage cards,
                // and a cone sample re-rolled every frame ripples them exactly like the canopy on land (sunSampleFrame).
                vec3 Ls = L;
                if (hasFlag(FLAG_SOFT_SHADOWS)) {
                    Ls = s.isFoliage
                        ? sunShadowDirectionAt(L, sunRadius(), sunShadowRotation(s, false, p, false), 0u, 0u, 1u)
                        : coneAround(L, sunRadius(), seed);
                }
                uwLit = waterSunBeam(o, s.worldPos.xz, Ls, med, Lw, uwOrigin, uwDir, uwGain);
                L = Lw;
            }
            float ndotl = max(dot(s.ns, L), 0.0);
            float ngdotl = dot(s.ng, L);
            // Light through a thin leaf card: a plant seen against the sun has ngdotl < 0, so the front-face shadow ray below
            // never ran and `vis` stayed zero, which also zeroed the backScatter term that exists for this exact case (dark
            // grass on a fully sunlit slope). The ray starts on the sun side of the card so the blade does not shadow itself.
            float leafBack = s.isFoliage ? max(dot(-s.ng, L), 0.0) : 0.0;
            // Direct light of the sun/moon: hard shadow ray, or shadowRays() rays jittered inside the sun cone (soft shadows).
            if (underwater) {
                if (uwLit && keyLightOn() && ndotl > 0.0 && ngdotl > 0.0) {
                    vis = hasFlag(FLAG_SHADOWS) ? traceTransmittance(uwOrigin, uwDir, 2048.0) * uwGain : vec3(1.0);
                } else if (uwLit && keyLightOn() && leafBack > 0.0) {
                    vis = hasFlag(FLAG_SHADOWS) ? traceTransmittance(uwOrigin, uwDir, 2048.0) * uwGain : vec3(1.0);
                }
            } else if (keyLightOn() && ndotl > 0.0 && ngdotl > 0.0) {
                if (!hasFlag(FLAG_SHADOWS)) {
                    vis = vec3(1.0);
                } else {
                    // Built here, behind both guards: the geometry validation inside it is a ray, and a back face or a dark
                    // key light never traces the shadow ray that would use it.
                    vec3 shadowO = cellShadow ? pixelShadowOrigin(s, o) : o;
                    if (hasFlag(FLAG_SOFT_SHADOWS)) {
                        // The cell rotation gives the whole cell the same sun-disk samples; when the origin was not snapped
                        // the rotation is still world-locked, so the penumbra does not boil with the accumulating jitter.
                        ivec2 rotation = sunShadowRotation(s, cellShadow, p, dot(camJitter, camJitter) > 1.0e-10);
                        uint n = shadowRays();
                        for (uint i = 0u; i < n; i++) {
                            vis += traceTransmittance(shadowO, sunShadowDirectionAt(L, sunRadius(), rotation, sunSampleFrame(s.isFoliage, pc.frame), i, n), 2048.0);
                        }
                        vis /= float(n);
                    } else {
                        vis = traceTransmittance(shadowO, L, 2048.0);
                    }
                }
            } else if (keyLightOn() && leafBack > 0.0) {
                if (!hasFlag(FLAG_SHADOWS)) {
                    vis = vec3(1.0);
                } else if (hasFlag(FLAG_SOFT_SHADOWS)) {
                    // Same cone of rays as the front face, from the sun side of the leaf: a hard single ray here would put a
                    // crisp leaf shadow next to the soft ones of the ground it stands on.
                    uint n = shadowRays();
                    vec3 lo = leafShadowOrigin(s, L);
                    ivec2 rotation = sunShadowRotation(s, false, p, dot(camJitter, camJitter) > 1.0e-10);
                    for (uint i = 0u; i < n; i++) {
                        vis += traceTransmittance(lo, sunShadowDirectionAt(L, sunRadius(), rotation, sunSampleFrame(s.isFoliage, pc.frame), i, n), 2048.0);
                    }
                    vis /= float(n);
                } else {
                    vis = traceTransmittance(leafShadowOrigin(s, L), L, 2048.0);
                }
            }
            // Ambient occlusion: cosine-weighted rays inside the AO radius, raw (noisy) result.
            float ao = 1.0;
            float radius = aoRadius();
#ifdef VKB_GBUFFER
            float gbHitDist = radius;
            // The denoiser needs one closest-hit distance for the diffuse guide; the AO visibility itself is unused with GI.
            const uint AO_STEPS_WITH_GI = 1u;
#else
            const uint AO_STEPS_WITH_GI = 0u;
#endif
            uint aoSamples = aoSampleCount();
            // With traced GI the indirect term comes from the bounce, so only ray 0 still runs: it is the one whose hit
            // distance feeds the denoiser guide (gbDiffuse.a), so this is the same guide for a fraction of the traversal.
            uint aoSteps = (hasFlag(FLAG_GI) && mode == MODE_LIT) ? min(AO_STEPS_WITH_GI, aoSamples) : aoSamples;
            if (aoSteps > 0u && (mode == MODE_LIT || mode == MODE_AO || mode == MODE_REFLECTION || mode == MODE_GI)) {
                vec3 tangent;
                vec3 bitangent;
                basisAround(s.ng, tangent, bitangent);
                uint aoSeed = uint(p.x) * 1973u + uint(p.y) * 9277u + pc.frame * 26699u + 1u;
                float open = 0.0;
                for (uint i = 0u; i < aoSteps; i++) {
                    vec3 h = cosineHemisphere(hasFlag(FLAG_LOWDISC) ? noise2D(p, pc.frame, i, aoSamples, 1u) : vec2(rand01(aoSeed), rand01(aoSeed)));
                    vec3 d = tangent * h.x + bitangent * h.y + s.ng * h.z;
#ifdef VKB_GBUFFER
                    // Only the first ray reports its hit distance to the denoiser (closest hit); the others need a yes/no
                    // answer, which a terminate-on-first-hit query gives for a fraction of the traversal cost.
                    if (i == 0u) {
                        float aoT = traceDist(o, d, radius);
                        open += aoT >= radius ? 1.0 : 0.0;
                        gbHitDist = aoT;
                    } else {
                        open += traceVisibility(o, d, radius);
                    }
#else
                    open += traceVisibility(o, d, radius);
#endif
                }
                ao = open / float(aoSteps);
            }
            ao *= s.mapAo;
            if (mode == MODE_SHADOW) {
                color = vec3(vis);
            } else if (mode == MODE_AO) {
                color = vec3(ao);
            } else {
                float day = pc.keyDir.w;
                // Block light through the emitter list: emissiveRays() NEE samples (RIS over the emitters, one visibility ray
                // each). Past the NEE reach the list cannot serve this receiver any more (its candidates are all farther than
                // EMITTER_RADIUS from it), so the vanilla block-light field takes the term over there and the walk is skipped:
                // a distant torch lights the ground it stands on instead of leaving it black, and distant pixels cost no rays.
                vec3 emissiveLight = vec3(0.0);
                // s.pos is camera-relative (fetchSurface: origin + dir * t, with the camera origin as the origin), so the
                // distance the emitter list is sorted by is length(s.pos). Not s.t: since the camera ray crosses its
                // interfaces in one traversal, s.t is the absolute distance for glass and only a refracted water segment
                // resets the origin, which is why the distance is taken from the position.
                float cameraDist = length(s.pos);
                // RtEmitters builds its list within emissiveDistance() + 8 blocks of the camera (RtFrameRenderer).
                float listRange = emissiveDistance() + 8.0;
                float farMix = blockLightFarMix(cameraDist, listRange);
                // Past the list's reach the vanilla block light is already inside emissiveLight (distantBlockLight), so the
                // optional baked fill must not add it a second time: its weight fades out over the same band.
                float blockFillScale = 1.0;
                if (hasFlag(FLAG_EMISSIVE) && hasFlag(FLAG_MATERIALS)) {
                    float reach = emissiveDistance();
                    // A surface with no vanilla block light (a LabPBR glow, an emissive item) has nothing to fall back to:
                    // its whole block term is the traced one, however far the camera is.
                    if ((farMix < 0.999 || s.light.x <= 0.0) && emitterCount() > 0u) {
                        uint n = emissiveRays();
                        // Pixel shadows: the emitter shadow ray starts at the centre of this fragment's world cell, the same
                        // cell the sun shadow uses, so torch and lava shadows get the blocky staircase too.
                        bool emCellShadow = pixelShadowApplies(s, underwater);
                        if (StatsBuf(pc.statsAddr).reservoirAddr.x != 0u) {
                            // ReSTIR DI: one reservoir per pixel, merging this frame's candidates with the reprojected sample.
                            emissiveLight = sampleEmittersTemporal(s, vec3(1.0), reach, seed, p, size, n * NEE_CANDIDATES,
                                emCellShadow);
                        } else {
                            for (uint i = 0u; i < n; i++) {
                                emissiveLight += sampleEmitters(s, vec3(1.0), reach, seed, emCellShadow);
                            }
                            emissiveLight /= float(n);
                        }
                    }
                    emissiveLight = distantBlockLight(emissiveLight, s, cameraDist, listRange);
                    blockFillScale = 1.0 - farMix;
                }
                // Indirect light: traced sky light (cosine rays towards the sky) with contact AO, or one traced bounce (GI).
                vec3 indirect;
                if (hasFlag(FLAG_GI)) {
                    uint n = giRays();
                    float reach = giDistance();
                    vec3 gi = vec3(0.0);
                    for (uint i = 0u; i < n; i++) {
                        vec3 d = hasFlag(FLAG_LOWDISC) ? cosineAroundU(s.ns, noise2D(p, pc.frame, i, n, 2u)) : cosineAround(s.ns, seed);
                        if (dot(d, s.ng) < 0.015) {
                            d = normalize(d + s.ng * 0.03);
                        }
                        Surface r;
                        vec3 fCol;
                        gi += traceSecondary(o, d, reach, seed, r, fCol) ? fCol * shadeSecondary(r, d) : fCol * skyRadiance(d);
                    }
                    // estimator of the Lambert-reflected bounce light: albedo * mean(L); AO of the map texture only
                    float skyVis = clamp(s.light.y, 0.0, 1.0);
                    vec3 canopyFill = hemisphereAmbient(s.ns.y, day) * (0.26 * skyVis * skyVis);
                    indirect = (gi / float(n) + canopyFill) * s.mapAo;
                } else {
                    uint skySeed = pcgHash(uint(p.x) * 2654435761u + uint(p.y) * 40503u + pc.frame * 48271u + 5u);
                    indirect = applyBakedSky(tracedSkyLight(s, max(aoSamples, 1u), skySeed), s) * ao;
                }
                float terminator = smoothstep(0.0, 0.08, ngdotl);
                vec3 directSun = pc.keyColor.rgb * ndotl * vis * terminator;
                if (leafBack > 0.0) {
                    directSun += pc.keyColor.rgb * (leafBack * 0.42) * smoothstep(0.0, 0.08, leafBack) * vis * vec3(1.05, 1.25, 0.75);
                }
                vec3 direct = directSun + bakedBlockFill(s) * blockFillScale;
                // Emissive exitance is view independent: evaluate its colour classification once, not three times per pixel.
                vec3 selfEmission = emitted(s);
                vec3 diffuseLight = direct + indirect + emissiveLight;
                vec3 diffuse = s.albedoLit * diffuseLight;
                color = (diffuse + selfEmission) * thr;
                // Reflections: smooth dielectrics (water, glass, polished stone) and metals.
                bool wantsRefl = hasFlag(FLAG_REFLECTIONS) && (s.metal > 0.5 || s.roughness < 0.6);
                vec3 refl = vec3(0.0);        // traced specular radiance (noisy, denoised by NRD / DLSS-RR)
                vec3 specSun = vec3(0.0);     // analytic GGX sun/moon highlight (noise-free, stays in gbDirect)
                float reflDist = rayDistance();   // mean reflection hit distance for the specular denoiser
                // kD is the diffuse share of the energy and applies even when reflections are switched off: a metal has no
                // diffuse exitance at all, it must not become a diffuse surface just because the reflection rays are off.
                vec3 V = -rayDir;
                float cosV = max(dot(V, s.ns), 0.0);
                vec3 f0 = s.metal > 0.5 ? s.albedoTex : vec3(s.f0);
                vec3 kD = s.metal > 0.5 ? vec3(0.0) : vec3(1.0) - fresnelSchlick(f0, cosV);
                // Without traced reflections the whole energy stays in the diffuse channel, and the G-buffer says so too.
                vec3 directScale = wantsRefl ? kD : vec3(1.0);
                vec3 diffK = directScale;
                if (wantsRefl) {
                    float alpha = max(s.roughness * s.roughness, 1.0e-3);
                    float alphaSq = alpha * alpha;
                    // Below ~2 degrees of roughness the VNDF is a mirror: one exact reflect, no sampling noise.
                    bool mirror = alpha <= 1.0e-3 || cosV <= 1.0e-3;
                    uint n = mirror ? 1u : reflectionRays();
                    vec3 incoming = vec3(0.0);
                    float distSum = 0.0;
                    for (uint i = 0u; i < n; i++) {
                        vec3 rdir;
                        vec3 weight;
                        if (mirror) {
                            rdir = reflect(rayDir, s.ns);
                            weight = fresnelSchlick(f0, cosV);
                        } else {
                            vec2 u;
                            if (hasFlag(FLAG_LOWDISC)) {
                                u = noise2D(p, pc.frame, i, n, 3u);
                            } else {
                                float u1 = rand01(seed);
                                float u2 = rand01(seed);
                                u = vec2(u1, u2);
                            }
                            float vdotH;
                            vec3 H = sampleGgxVndf(s.ns, V, alpha, u, vdotH);
                            rdir = reflect(rayDir, H);
                            // BRDF * cosine / VNDF pdf = F(V.H) * G2 / G1, so D and the pdf cancel exactly.
                            weight = fresnelSchlick(f0, vdotH) * smithG2OverG1(cosV, dot(rdir, s.ns), alphaSq);
                        }
                        rdir = bendHorizon(rdir, s.ng);
                        Surface r;
                        vec3 fCol;
                        bool hitRefl = traceSecondary(o, rdir, rayDistance(), seed, r, fCol);
                        distSum += hitRefl ? r.t : rayDistance();
                        // The key light is sampled explicitly by the GGX lobe below; only the mirror case takes the sun/moon
                        // body from the reflected sky, otherwise the light would be counted twice. The environment is only
                        // needed on a miss (?: evaluates one branch), so no cloud/sky model runs on a reflection hit.
                        incoming += weight * (hitRefl ? fCol * shadeReflectionHit(r, rdir, hasFlag(FLAG_SHADOWS))
                                                      : fCol * (mirror ? skyAt(rdir) : skyEnvRadiance(rdir, s.roughness)));
                    }
                    // A single VNDF sample of a just-above-mirror lobe can hit the sun disk at full weight; cap the radiance
                    // so that one unlucky sample cannot become a persistent firefly after accumulation.
                    refl = min(incoming / float(n), vec3(256.0));
                    reflDist = distSum / float(n);
                    // Specular sun highlight with Cook-Torrance GGX microfacet BRDF (mirror: the disk is in skyAt above).
                    // Noise-free, so it goes to gbDirect and the denoiser cannot blur the glint.
                    if (!mirror && keyLightOn() && ndotl > 0.0 && length(vis) > 0.001) {
                        vec3 specGGX = brdfSpecularGGX(s.ns, V, L, max(s.roughness, 0.04), f0);
                        specSun = pc.keyColor.rgb * vis * specGGX * ndotl;
                    }
                    color = (diffuse * kD + refl + specSun + selfEmission) * thr;
                }
#ifdef VKB_GBUFFER
                if (mode == MODE_LIT) {
                    // NRD and DLSS-RR receive the effective bobbed camera pose, so IN_VIEWZ uses that same view space.
                    float viewZ = -dot(s.pos - cameraOrigin(), bobCameraForward());
                    imageStore(gbViewZ, p, vec4(viewZ, 0.0, 0.0, 0.0));
                    vec3 nOut = hasFlag(FLAG_GEOMETRIC_NORMALS) ? s.ng : s.ns;
                    vec3 n = length(nOut) > 1.0e-4 ? normalize(nOut) : vec3(0.0, 0.0, 1.0);
                    float r = clamp(s.roughness, 0.0, 1.0);
                    imageStore(gbNormalRough, p, vec4(n, r));
                    // Raw (not divided by the albedo) radiance: NRD demodulates it in rt_pack_nrd.comp, DLSS-RR takes it as is.
                    imageStore(gbDiffuse, p, vec4((indirect + emissiveLight) * diffK * thr * atmT, gbHitDist));
                    imageStore(gbAlbedo, p, vec4((wantsRefl && s.metal > 0.5) ? vec3(0.0) : clamp(s.albedoLit, 0.0, 1.0), 1.0));
                    imageStore(gbSpecular, p, vec4(refl * thr * atmT, reflDist));
                    imageStore(gbSpecAlbedo, p, vec4(clamp(wantsRefl ? f0 : vec3(0.0), 0.0, 1.0), 1.0));
                    vec3 directOut = (s.albedoLit * direct * directScale + specSun + selfEmission) * thr + glassRefl;
                    // NRD / DLSS-RR demodulate this channel later and their history keeps a bad value alive far longer than one
                    // frame, so a non-finite direct term is dropped here, where the main output is sanitised too.
                    if (isnan(directOut.r) || isinf(directOut.r)) directOut.r = 0.0;
                    if (isnan(directOut.g) || isinf(directOut.g)) directOut.g = 0.0;
                    if (isnan(directOut.b) || isinf(directOut.b)) directOut.b = 0.0;
                    imageStore(gbDirect, p, vec4(directOut * atmT + atmA, 0.0));
                    StatsBuf fb = StatsBuf(pc.statsAddr);
                    if (fb.motionAddr != uvec2(0u)) {
                        Vec4Buf(fb.motionAddr).v[p.y * size.x + p.x] = vec4(s.motion,
                            (isEntityHit(s.slot) || dot(s.motion, s.motion) > 1.0e-8) ? 1.0 : 0.0);
                    }
                }
#endif
                if (mode == MODE_REFLECTION) {
                    color = refl * thr;
                } else if (mode == MODE_GI) {
                    color = s.albedoLit * indirect * thr;
                }
                if (mode == MODE_LIT) {
                    // When hard shadows or temporal upscaler jitter are active, keep directSun in the unfiltered rAcc channel
                    // so the 17x17 a-trous spatial filter and low-res temporal reprojection do not blur or wobble shadow edges.
                    bool keepSunSharp = !hasFlag(FLAG_SOFT_SHADOWS) || (dot(camJitter, camJitter) > 1.0e-10);
                    vec3 filteredDiff = keepSunSharp ? (bakedBlockFill(s) * blockFillScale + indirect + emissiveLight) : diffuseLight;
                    diffE = filteredDiff * diffK * thr;
                }
                tonemapped = true;
            }
        }
    } else {
        // Every hit branch above overwrites the colour, so the sky model is evaluated only where nothing was hit: its cloud
        // DDA and sun/moon/stars texels used to run for every pixel and then get thrown away.
        color = skyDisplay(rayDir);
#ifdef VKB_GBUFFER
        if (mode == MODE_LIT) {
            imageStore(gbViewZ, p, vec4(1.0e6, 0.0, 0.0, 0.0));   // beyond CommonSettings.denoisingRange: NRD ignores the pixel
            imageStore(gbNormalRough, p, vec4(0.0, 0.0, 1.0, 1.0));
            imageStore(gbDiffuse, p, vec4(0.0));
            imageStore(gbAlbedo, p, vec4(0.0));
            imageStore(gbDirect, p, vec4(0.0));
            imageStore(gbSpecular, p, vec4(0.0));
            imageStore(gbSpecAlbedo, p, vec4(0.0));
            StatsBuf fb = StatsBuf(pc.statsAddr);
            if (fb.motionAddr != uvec2(0u)) {
                Vec4Buf(fb.motionAddr).v[p.y * size.x + p.x] = vec4(0.0);
            }
        }
#endif
    }
    if (mode == MODE_LIT) {
        if (!hit) {
            color *= thr;                // sky seen through glass / water keeps their tint and (1 - F)
        }
        color += glassRefl;              // mirror reflections of the interfaces in front (deterministic)
    }
    // distance fog / god rays were applied above, before the shading branch (gbuffer channels carry them too)
    vec3 colorPre = color;
    color = colorPre * atmT + atmA;
    vec3 mean = color;
    if (sawWater) {
        gHistoryLimit = 8.0;   // moving waves: a long history would freeze the animation into a smear
    }
#ifdef VKB_ACCUM
    if (hasFlag(FLAG_ACCUMULATE)) {
        // two signals: diffuse irradiance (remodulated with this frame's albedo) and the rest (reflections, emission, fog, glass)
        bool split = hit && hasFlag(FLAG_DEMODULATE) && mode == MODE_LIT && tonemapped;
        vec3 eAcc = split ? diffE * atmT : vec3(0.0);
        vec3 alb = split ? s.albedoLit : vec3(1.0);
        vec3 rAcc = split ? max(colorPre - alb * diffE, vec3(0.0)) * atmT + atmA : color;
        bool hasJitter = (dot(camJitter, camJitter) > 1.0e-10);
        if (hasJitter && split) {
            // Temporal upscaler (DLSS/FSR/XeSS) reconstructs subpixel detail at native resolution; do not average rAcc across
            // low-res jittered frames before the upscaler runs, or sharp edges/shadows/reflections smear into a box blur.
            mean = temporalAccumulate(p, size, eAcc, vec3(0.0), hit, hit ? s.pos : vec3(0.0), hit ? s.ng : vec3(0.0), hit ? s.t : 0.0,
                alb, split) + rAcc;
            int cur = int(pc.frame & 1u);
            imageStore(accumImage, ivec2(p.x, p.y + (7 + cur) * size.y), vec4(rAcc, 0.0));
        } else {
            mean = temporalAccumulate(p, size, eAcc, rAcc, hit, hit ? s.pos : vec3(0.0), hit ? s.ng : vec3(0.0), hit ? s.t : 0.0,
                alb, split);
        }
    }
#endif
    countSample(p, hit);
    // clamp() of NaN is undefined, so the frame is sanitised the way the path tracer does it: one non-finite value (a degenerate
    // triangle, a camera-ray w, a bad normal map) would otherwise be written out and then kept alive by the temporal history.
    if (isnan(mean.r) || isinf(mean.r)) mean.r = 0.0;
    if (isnan(mean.g) || isinf(mean.g)) mean.g = 0.0;
    if (isnan(mean.b) || isinf(mean.b)) mean.b = 0.0;
    imageStore(outDepth, p, vec4(hadFirst ? firstDist : (hit ? s.t : 1.0e6), 0.0, 0.0, 0.0));
    imageStore(outImage, p, vec4(clamp(tonemapped ? finishColor(mean) : mean, 0.0, 1.0), 1.0));
}
