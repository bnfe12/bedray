#version 460
// Path Tracing mode (RtPathTracerPass): unidirectional path tracer over the TLAS of Sodium sections and entities (mask 0x03: MASK_WORLD | MASK_ENTITIES).
//  - camera ray jittered inside the pixel (anti-aliasing through accumulation);
//  - at every vertex: emission of the surface (emissive blocks light the scene by being hit), next event estimation of the
//    sun/moon (one shadow ray inside the sun cone);
//  - continuation: specular lobe (metals always; smooth dielectrics with probability ~ Fresnel) or cosine-weighted diffuse
//    lobe; early probabilistic path termination from the 3rd vertex on;
//  - misses return the sky radiance (sun disk only after a specular bounce: the diffuse sun is already sampled by NEE);
//  - temporal accumulation into accumImage while the camera and the scene stand still (accumCount from RtPathTracerPass).
// Scene access and sunDisk live in rt_common.glsl. Compiled with "#define VKB_ACCUM 1".
#include "rt_common.glsl"

struct PathResult {
    vec3 radiance;     // full estimate
    vec3 indirect;     // contributions of vertices after the first (debug view gi)
    vec3 firstEmission;
    float pathLength;  // vertices visited
    vec3 direct0;      // first vertex: emission + sun NEE (kept out of NRD; sun NEE joins DLSS-RR when requested)
    float bounceDist;  // length of the first bounce ray (NRD hit distance), reach when it missed
    float waterSeen;   // 1 when the path started in or crossed a water boundary (temporal history of water is capped)
    float firstDist;   // distance to first hit (interface or solid) from camera
};

uint gSunSub = 0u;   // sample index inside the frame (spp loop)
uint gSunSpp = 1u;
// One flag per pixel (globals are per invocation), raised by any spp sample whose key light came through a leaf: the counter is
// added once per pixel, because the denominator (stats.hits) is also per pixel and spp would otherwise push leaf_pct past 100%.
bool gLeafBacklit = false;

// Additive artistic sky fill on the primary hit. Its 0.28 factor preserves the open-sky budget of the old
// 0.28 * skyVis^2 * hemisphereAmbient term; it is not a split of the independently sampled diffuse-bounce sky. Traced occlusion
// lets a canopy gap or window fill shade that baked vertex light squared crushed to near black, while a sealed room stays dark.
// Every jittered spp hit traces its own visibility: reusing even a position/normal-compatible result can leak across a silhouette.
// The sample comes from the path seed, which is per pixel and per frame (tracePath). Seeding it from the world cell
// floor(worldPos * 8) instead made every pixel of a 1/8-block cell share one visibility ray and its binary open / blocked
// answer, and under a canopy that drew a regular grid of lit and dark squares eight cells wide per block face: an artifact the
// denoiser preserves as if it were texture detail, where per-pixel noise is what it is built to average away.
vec3 primarySkyFill(Surface s, inout uint seed) {
    if (s.light.y <= 0.02) {
        return vec3(0.0);
    }
    return tracedSkyLight(s, 1u, seed);
}

// first / firstHit: the first solid surface of the camera ray (albedo, normals, section fade, temporal accumulation).
// firstVisible / firstVisibleHit: the first non-cutout surface of any kind; for a camera ray that starts on glass, ice or water
// it is that interface, so the G-buffer can denoise the whole pixel seen through it instead of leaving it at 1 spp.
PathResult tracePath(vec3 origin, vec3 dir, WaterMedium med, inout uint seed, out Surface first, out bool firstHit,
    out Surface firstVisible, out bool firstVisibleHit, ivec2 p) {
    PathResult res;
    res.radiance = vec3(0.0);
    res.indirect = vec3(0.0);
    res.firstEmission = vec3(0.0);
    res.pathLength = 0.0;
    res.direct0 = vec3(0.0);
    res.bounceDist = rayDistance();
    res.firstDist = 1.0e6;
    res.waterSeen = med.inside ? 1.0 : 0.0;
    vec3 thr = vec3(1.0);
    vec3 o = origin;
    vec3 d = dir;
    bool specularBefore = true;   // the camera ray sees the sun disk
    uint bounces = max(1u, maxBounces());
    float reach = rayDistance();
    firstHit = false;
    firstVisibleHit = false;
    uint transCount = 0u;
    for (uint b = 0u; b <= bounces; b++) {
        Surface s;
        bool hitHere = traceSurface(o, d, b == 0u ? 0.001 : 0.0, b == 0u ? 4096.0 : reach, false, b == 0u, s);
        if (med.inside) {
            // water body: depth absorption of the segment and the light scattered towards the eye (rt_common.glsl waterSegment)
            vec3 T;
            vec3 ins;
            waterSegment(med, o, d, hitHere ? s.t : min(reach, 48.0), T, ins);
            vec3 e = thr * ins;
            res.radiance += e;
            if (b == 0u) {
                res.direct0 += e;
            } else {
                res.indirect += e;
            }
            thr *= T;
        }
        if (hitHere && ((b > 0u && s.isOutline) || (!s.translucent && s.alpha < 0.5) || s.alpha < 0.05)) {
            // Cutout transparent pixel or secondary ray hitting selection outline ribbon - pass through!
            o = s.pos + d * 0.002;
            b--;
            continue;
        }
        if (hitHere && !firstVisibleHit) {
            // firstVisible is the first surface the camera ray met, interface or solid; the caller keeps it only when the
            // path continued through a pane (there is no solid first hit then). Written here instead of a second copy that
            // had to stay live until the end of the loop.
            res.firstDist = s.t;
            firstVisible = s;
            firstVisibleHit = true;
        }
        if (b == 1u && hitHere) {
            res.bounceDist = s.t;
        }
        if (!hitHere) {
            vec3 sky = b == 0u ? skyAt(d) : (specularBefore ? skyRadiance(d) + sunDisk(d) : skyRadiance(d));
            vec3 c = thr * sky;
            res.radiance += c;
            if (b > 0u) {
                res.indirect += c;
            }
            break;
        }

        // Thin dielectric interface (glass, stained glass, water, ice; rt_common.glsl interface*), handled without random
        // choices: the path always continues straight through with weight (1 - F) * absorption. The mirror reflection of the
        // FIRST interface seen from the camera is added once, estimated with one deterministic ray (mirrorRadiance), to direct0
        // (the channel the denoisers pass through unchanged, so glass does not smear into the diffuse signal). Reflections of
        // deeper interfaces (back faces, panes behind panes; F = 2..8 %) are dropped: sampling them by Fresnel was the
        // per-pixel sparkle on stained glass.
        if (isInterface(s) && transCount < 24u) {
            transCount++;
            float F = interfaceReflectance(s, d);
            bool volume = s.isWater && waterVolumeStyle() && isWaterBoundary(s);
            if (b == 0u && transCount == 1u) {
                vec3 rdir = bendHorizon(reflect(d, s.ns), s.ng);
                if (volume && s.roughness > 0.03) {
                    rdir = bendHorizon(coneAround(rdir, s.roughness * s.roughness, seed), s.ng);   // far sheen: waves below the pixel
                }
                vec3 refl = interfaceMirror(volume && F < 0.05, offsetOrigin(s), rdir, reach, true, med);
                vec3 e = thr * F * refl;
                res.radiance += e;
                res.direct0 += e;
            }
            if (volume) {
                bool entering = d.y < 0.0;
                if (b > 0u && F > 0.999) {
                    // total internal reflection of a secondary ray keeps the light inside the pool; the partial reflection is not
                    // sampled (a random Fresnel split made the floor under water grainy)
                    d = bendHorizon(reflect(d, s.ns), s.ng);
                    o = s.pos + s.ng * 0.002;
                    b--;
                    continue;
                }
                vec3 rd = refract(d, s.ns, entering ? 1.0 / WATER_IOR : WATER_IOR);
                if (dot(rd, rd) < 0.5) {
                    break;   // total internal reflection on the camera path: the mirror estimate above carries it
                }
                thr *= interfaceTransmittance(s, F);
                crossWaterBoundary(med, s, d);
                res.waterSeen = 1.0;
                d = normalize(rd);
                o = s.pos + d * 0.002;
                b--;
                continue;
            }
            if (s.isWater && !volume) {
                // vanilla style: the animated water sprite (biome tint) is blended over the scene behind it
                vec3 e = thr * ((1.0 - F) * VANILLA_WATER_ALPHA) * vanillaWaterSurface(s, d, reach, seed);
                res.radiance += e;
                if (b == 0u) {
                    res.direct0 += e;
                } else {
                    res.indirect += e;
                }
                crossWaterBoundary(med, s, d);
                res.waterSeen = 1.0;
            }
            thr *= interfaceTransmittance(s, F);
            if (max(thr.r, max(thr.g, thr.b)) < 0.004) {
                break;   // nothing is left of the light behind this layer
            }
            o = s.pos + d * 0.002;
            b--;
            continue;
        }

        res.pathLength += 1.0;
        if (b == 0u) {
            if (!firstHit && transCount > 0u) {
                // The ray origin was reset at the last interface, so s.t is the distance from the glass to the surface behind
                // it: that is the hit distance the denoisers should blur by, not the distance to the pane itself.
                res.bounceDist = s.t;
            }
            first = s;
            firstHit = true;
        }
        // Emission seen by the camera or through a mirror-like bounce; after a diffuse bounce the emitters were already
        // sampled by NEE at the previous vertex (adding them again would count them twice).
        if (b == 0u || specularBefore) {
            vec3 e = thr * emitted(s);
            res.radiance += e;
            if (b == 0u) {
                res.firstEmission = e;
                res.direct0 += e;
            } else {
                res.indirect += e;
            }
        }
        if (b == bounces) {
            break;
        }
        vec3 so = offsetOrigin(s);
        float cosV = max(dot(-d, s.ns), 0.0);
        float baseF0 = s.metal > 0.5 ? 1.0 : s.f0;
        vec3 f0 = s.metal > 0.5 ? s.albedoTex : vec3(baseF0);
        // Energy split. Above ROUGH_SPLIT a dielectric gets no specular lobe below (ps = 0), so the full grazing Schlick
        // term removed diffuse energy that nothing reflected back: the far end of a wall next to the player and the floor
        // away from the crosshair darkened by up to 60% into a radial vignette. Such surfaces keep the constant F0.
        vec3 F = fresnelEnergySplit(f0, cosV, s.roughness, s.metal > 0.5);
        float Fsc = clamp(max(F.r, max(F.g, F.b)), 0.0, 1.0);
        float gloss = clamp(1.0 - s.roughness, 0.0, 1.0);
        // probability of the specular lobe: balanced baseline so reflections are clear even looking head-on
        float ps = s.metal > 0.5 ? 1.0 : (s.roughness < ROUGH_SPLIT ? clamp(max(Fsc, 0.45 * gloss), 0.05, 0.95) : 0.0);

        // NEE of the sun/moon for the diffuse lobe (the specular lobe sees the sun disk through the sky instead).
        // Everything the key light needs is computed inside this gate: a metal vertex (its own BRDF has no diffuse lobe)
        // and a switched-off key light used to pay for the disk sample and the rotation index, and the deeper-vertex cone
        // sample also advanced the random stream there.
        if (s.metal < 0.5 && keyLightOn()) {
            // Pixel shadows: the whole cell shares one sun-disk sample and one shadow-ray origin
            // (rt_common_pixel_shadow.glsl), the pairing rt_rays.comp makes. Without it a cell keeps a per-pixel disk
            // sample while its shadow ray starts from the cell centre, so the deliberately blocky penumbra fills with
            // per-pixel speckle. First vertex only: the deeper ones are 1 spp and denoised, so quantising them would
            // cost a validation ray each and change nothing visible.
            bool cellShadow = b == 0u && pixelShadowApplies(s, med.inside);
            ivec2 rotation = sunShadowRotation(s, cellShadow, p, false);
            // first hit: low-discrepancy sample of the sun disk; deeper vertices keep the random cone sample, except on a leaf.
            // A deeper plant vertex has the same 0.6-per-layer staircase, so a cone direction re-rolled every frame flips its
            // texels exactly like the direct term did: it keeps one disk direction of its own block instead (sunSampleFrame).
            vec3 L = b == 0u
                ? sunShadowDirectionAt(pc.keyDir.xyz, sunRadius(), rotation, sunSampleFrame(s.isFoliage, pc.frame), gSunSub, gSunSpp)
                : s.isFoliage
                    ? sunShadowDirectionAt(pc.keyDir.xyz, sunRadius(), sunShadowRotation(s, false, p, false), 0u, 0u, 1u)
                    : coneAround(pc.keyDir.xyz, sunRadius(), seed);
            vec3 Ls = L;
            vec3 tr = vec3(0.0);
            bool lit = false;
            float ndotl = 0.0;
            float ngdotl = 0.0;
            // Pixel shadows: the shadow ray starts from the centre of the world cell, not from this fragment.
            vec3 shOrigin = cellShadow ? pixelShadowOrigin(s, so) : so;
            vec3 shDir = L;
            vec3 gain = vec3(1.0);
            if (med.inside) {
                // sun under water: refracted shadow ray, absorption, Fresnel and the analytic caustic (rt_common.glsl waterSunBeam)
                lit = waterSunBeam(so, s.worldPos.xz, L, med, Ls, shOrigin, shDir, gain);
            } else {
                lit = true;
            }
            ndotl = max(dot(s.ns, Ls), 0.0);
            ngdotl = dot(s.ng, Ls);
            // Light through a thin leaf card. A plant seen against the sun has ngdotl < 0 and ndotl == 0, so the front-face
            // branch skipped it entirely: every back-lit plant received no key light at all (dark grass dots on the sunlit
            // slope ahead of the camera), and the backScatter term that was meant for exactly this case sat inside the
            // front-face gate, where ndotl > 0 forces it to zero. The shadow ray starts on the sun side of the card so the
            // blade does not shadow itself.
            float leafBack = s.isFoliage ? max(dot(-s.ng, Ls), 0.0) : 0.0;
            if (lit && ndotl > 0.0 && ngdotl > 0.0) {
                tr = traceTransmittance(shOrigin, shDir, 2048.0) * gain;   // the only visibility ray of this vertex
            } else if (lit && leafBack > 0.0) {
                tr = traceTransmittance(med.inside ? shOrigin : leafShadowOrigin(s, Ls), shDir, 2048.0) * gain;
            } else {
                lit = false;
            }
            if (lit) {
                vec3 c = thr * s.albedoLit * (1.0 - Fsc) * pc.keyColor.rgb * ndotl * tr * s.mapAo * smoothstep(0.0, 0.08, ngdotl);
                if (leafBack > 0.0) {
                    c += thr * s.albedoLit * (1.0 - Fsc) * pc.keyColor.rgb * (leafBack * 0.42) * smoothstep(0.0, 0.08, leafBack)
                        * tr * s.mapAo * vec3(1.05, 1.25, 0.75);
                    // Diagnostic: a sunlit slope must show a non-zero share here, otherwise the leaf transmission reaches no
                    // pixel (still dark grass dots between the lit ones). Only delivered light counts: a chain of leaf blocks
                    // that swallows the ray returns tr = 0 and must not be reported as a working term.
                    if (b == 0u && ((p.x | p.y) & 3) == 0 && any(greaterThan(tr, vec3(0.0)))) {
                        gLeafBacklit = true;
                    }
                }
                res.radiance += c;
                if (b > 0u) {
                    res.indirect += c;
                } else if (!hasFlag(FLAG_SUN_DENOISED)) {
                    // DLSS-RR, and optionally NRD for a more stable soft sun, denoise first-hit sun visibility. Leaving
                    // this flag clear keeps the low-noise pass-through when preserving a sharper sun-shadow boundary.
                    res.direct0 += c;
                }
            }
        }
        // NEE of the emissive surfaces (light list), diffuse lobe only
        if (s.metal < 0.5 && hasFlag(FLAG_EMISSIVE)) {
            // Past the list's reach the camera-sorted emitter list cannot serve the receiver any more (rt_common_shade.glsl,
            // distantBlockLight): the vanilla block-light field takes the term over there. Only the primary hit has a camera
            // distance - a bounce is shaded where the previous vertex sent it and keeps the traced estimate. The list radius of
            // this mode is min(path distance, 128) blocks (RtFrameRenderer).
            float listRange = min(reach, 128.0);
            // s.t counts from the last interface (the origin is reset at every glass or water face) and s.pos is
            // camera-relative, so the distance the list was sorted by is length(s.pos).
            float cameraDist = length(s.pos);
            vec3 nee = vec3(0.0);
            // A surface with no vanilla block light (a LabPBR glow, an emissive item) has nothing to fall back to.
            if (b > 0u || blockLightFarMix(cameraDist, listRange) < 0.999 || s.light.x <= 0.0) {
                nee = sampleEmitters(s, vec3(1.0), reach, seed);
            }
            if (b == 0u) {
                nee = distantBlockLight(nee, s, cameraDist, listRange);
            }
            vec3 c = thr * (1.0 - Fsc) * s.mapAo * s.albedoLit * nee;
            res.radiance += c;
            if (b > 0u) {
                res.indirect += c;
            }
        }
        // Additive outdoor fill on the primary hit: traced sky occlusion instead of baked vertex sky light squared.
        // Caves and enclosed rooms (s.light.y == 0) stay completely dark.
        if (b == 0u && s.metal < 0.5 && s.light.y > 0.02) {
            vec3 canopyFill = thr * s.albedoLit * (1.0 - Fsc) * primarySkyFill(s, seed) * 0.28 * s.mapAo;
            res.radiance += canopyFill;
            res.indirect += canopyFill;
        }
        // continuation
        if (rand01(seed) < ps) {
            vec3 r = reflect(d, s.ns);
            float spread = s.roughness * s.roughness;
            if (spread > 0.001) {
                r = coneAround(r, spread, seed);
            }
            r = bendHorizon(r, s.ng);
            d = r;
            thr *= (s.metal > 0.5 ? F : F / max(ps, 1.0e-3));
            specularBefore = spread < 0.05;
        } else {
            d = cosineAround(s.ns, seed);
            if (dot(d, s.ng) < 0.015) {
                d = normalize(d + s.ng * 0.03);
            }
            // lambert: diffuse weight ensures exact unbiased balance with specular lobe probability
            float diffuseWeight = (1.0 - Fsc) / max(1.0 - ps, 1.0e-3);
            thr *= s.albedoLit * s.mapAo * diffuseWeight;
            specularBefore = false;
        }
        o = so;
        // Probabilistic path termination from the 2nd bounce on (unbiased Monte Carlo reweighting by 1/q).
        // A bounce off a surface carries a fraction of the incoming energy; dim paths terminate early
        // instead of spending full vertex traversals. The 0.5 floor bounds the energy reweighting at 2x (0.2 = 5x gave fireflies on dark albedo, which NRD smears into blotches).
        if (b >= 1u) {
            float q = clamp(max(thr.r, max(thr.g, thr.b)), 0.5, 0.95);
            if (rand01(seed) > q) {
                break;
            }
            thr /= q;
        }
    }
    return res;
}

void main() {
    WaterMedium med0 = cameraWaterMediumShared(cameraOrigin());   // camera under water: one ray per subgroup
    ivec2 size = imageSize(outImage);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    uint mode = viewMode();
    uint seed = pcgHash(uint(p.x) * 1973u + uint(p.y) * 9277u + pc.frame * 26699u + 7u);
    uint spp = sppCount();
    gSunSpp = spp;
    vec3 sum = vec3(0.0);
    bool anyHit = false;
    float waterSeen = 0.0;
    bool accHit = false;
    bool accInterface = false;
    // One surface copy for both consumers (temporal accumulation and the denoiser G-buffer). Three live copies of a
    // 26-field struct across the spp loop pushed the ray generation shader into local-memory spills.
    Surface accBest;
    float accFirstDist = 1.0e6;
#ifdef VKB_GBUFFER
    vec3 gbDirectSum = vec3(0.0);
    vec3 gbRestSum = vec3(0.0);
    float gbDist = 0.0;
#endif
    vec2 camJitter = getCameraJitter();
    bool hasJitter = (dot(camJitter, camJitter) > 1.0e-10);
    for (uint i = 0u; i < spp; i++) {
        vec2 jitter;
        if (hasJitter) {
            jitter = (i == 0u)
                ? (vec2(0.5) + camJitter)
                : fract(vec2(0.5) + camJitter + vec2(rand01(seed), rand01(seed)) - 0.5);
        } else {
#ifdef VKB_GBUFFER
            jitter = (mode == MODE_LIT && i == 0u) ? vec2(0.5) : vec2(rand01(seed), rand01(seed));
#else
            jitter = vec2(rand01(seed), rand01(seed));
#endif
        }
        gSunSub = i;
        vec3 dir = cameraRay(p, size, jitter);
        Surface first;
        bool firstHit;
        Surface firstVisible;
        bool firstVisibleHit;
        vec3 origin = cameraOrigin();
        PathResult r = tracePath(origin, dir, med0, seed, first, firstHit, firstVisible, firstVisibleHit, p);
        waterSeen = max(waterSeen, r.waterSeen);
        anyHit = anyHit || firstHit;
        if (i == 0u) {
            accHit = firstHit;
            // Camera ray that starts on a thin non-water interface (glass, stained glass, tinted glass, ice): the pixel is a
            // transmitted + reflected signal through the pane, so the accumulation keeps its history on the interface.
            accInterface = !firstHit && firstVisibleHit && isInterface(firstVisible) && !firstVisible.isWater;
            if (accHit) {
                accBest = first;
            } else if (accInterface) {
                accBest = firstVisible;
            }
            accFirstDist = r.firstDist;
#ifdef VKB_GBUFFER
            gbDist = r.bounceDist;   // same sample as the surface above: the denoiser depth must match its normal / albedo
#endif
        }
#ifdef VKB_GBUFFER
        gbDirectSum += r.direct0;
        gbRestSum += r.radiance - r.direct0;
#endif
        vec3 v;
        if (mode == MODE_GI) {
            v = r.indirect;
        } else if (mode == MODE_EMISSION) {
            v = r.firstEmission;
        } else if (mode == MODE_BOUNCES) {
            float k = r.pathLength / float(max(1u, maxBounces()) + 1u);
            v = vec3(k, 1.0 - abs(k * 2.0 - 1.0), 1.0 - k);   // blue = short paths, red = long
        } else if (mode == MODE_ALBEDO) {
            v = firstHit ? first.albedo : skyAt(dir);
        } else if (mode == MODE_NORMALS) {
            v = firstHit ? first.ns * 0.5 + 0.5 : vec3(0.0);
        } else if (mode == MODE_MATERIAL) {
            v = firstHit ? vec3(first.roughness, first.metal > 0.5 ? 1.0 : first.f0 * 4.0, first.emission) : vec3(0.0);
        } else {
            v = r.radiance;
            gSectionFade = firstHit ? sectionFade(first.slot) : 0.0;
            v = applyVolumetricAtmosphere(v, origin, dir, firstHit ? first.t : 1.0e6, firstHit);
        }
        // clamp fireflies of a single sample (emitters seen through a diffuse bounce)
        if (isnan(v.r) || isinf(v.r)) v.r = 0.0;
        if (isnan(v.g) || isinf(v.g)) v.g = 0.0;
        if (isnan(v.b) || isinf(v.b)) v.b = 0.0;
        v = max(v, vec3(0.0));
        float m = max(v.r, max(v.g, v.b));
        if (m > 16.0) {
            v *= 16.0 / m;
        }
        sum += v;
    }
    vec3 sampleValue = sum / float(spp);
    if (isnan(sampleValue.r) || isinf(sampleValue.r)) sampleValue.r = 0.0;
    if (isnan(sampleValue.g) || isinf(sampleValue.g)) sampleValue.g = 0.0;
    if (isnan(sampleValue.b) || isinf(sampleValue.b)) sampleValue.b = 0.0;
    sampleValue = clamp(sampleValue, vec3(0.0), vec3(16.0));

    vec3 mean = sampleValue;
    if (waterSeen > 0.5) {
        gHistoryLimit = 8.0;   // moving waves: a long history would freeze the animation into a smear
    }
#ifdef VKB_ACCUM
    if (hasFlag(FLAG_ACCUMULATE)) {
        bool accumHit = accHit || accInterface;
        if (hasJitter && accumHit && mode == MODE_LIT) {
            // Demodulate primary albedo when subpixel jitter is active so low-res temporalAccumulate never blurs
            // the 16x16 block texture across jittered positions before DLSS/FSR/XeSS reconstructs the frame.
            // Through glass the tint is a colour filter, not a diffuse albedo: demodulating by it would divide by a dark
            // value and amplify the transmitted noise, so an interface pixel uses albedo 1 and stores the full signal.
            vec3 alb = accHit ? max(accBest.albedoLit, vec3(0.02)) : vec3(1.0);
            vec3 eAcc = sampleValue / alb;
            mean = temporalAccumulate(p, size, eAcc, vec3(0.0), accumHit, accBest.pos,
                accBest.ng, accBest.t, alb, true);
        } else {
            // path tracing without upscaler jitter: the whole sample is one signal
            mean = temporalAccumulate(p, size, sampleValue, vec3(0.0), accumHit, accumHit ? accBest.pos : vec3(0.0),
                accumHit ? accBest.ng : vec3(0.0), accumHit ? accBest.t : 0.0, vec3(1.0), true);
        }
    }
#endif
    if (((p.x | p.y) & 3) == 0) {
        float lum = dot(mean, vec3(0.2126, 0.7152, 0.0722));
        if (!isnan(lum) && !isinf(lum) && lum > 0.0) {
            // metering window [0.02, 6]: black voids and the sun disk do not drag the average
            atomicAdd(StatsBuf(pc.statsAddr).lumLogSum, uint(clamp((log2(clamp(lum, 0.02, 6.0)) + 16.0) * 64.0, 0.0, 4095.0)));
        }
    }
    vec3 color = (mode == MODE_BOUNCES || mode == MODE_NORMALS || mode == MODE_MATERIAL || mode == MODE_ALBEDO) ? mean : finishColor(mean);
    if (gLeafBacklit) {
        atomicAdd(StatsBuf(pc.statsAddr).leafBacklit, 1u);
    }
    countSample(p, anyHit);
    imageStore(outDepth, p, vec4(accFirstDist < 1.0e5 ? accFirstDist : (accHit ? accBest.t : 1.0e6), 0.0, 0.0, 0.0));
    imageStore(outImage, p, vec4(clamp(color, 0.0, 1.0), 1.0));
#ifdef VKB_GBUFFER
    // NRD input (lit view only): raw per-frame radiance; rt_pack_nrd.comp demodulates it for NRD (albedo * denoised + direct)
    // and hands it to DLSS-RR unchanged (RR demodulates internally from the two albedo guides). Sky pixels are beyond the
    // denoising range and are skipped by the denoiser and the compose.
    // A camera ray that starts on a thin interface (glass, stained glass, tinted glass, ice) has no solid first hit of its own:
    // before this branch such a pixel was written as sky and skipped by NRD / DLSS-RR, leaving 1 ssp noise on every pane and on
    // everything seen through it. It is denoised at the pane now, with the pane's depth / normal and the whole transmitted +
    // reflected signal.
    if (mode == MODE_LIT && (accHit || accInterface)) {
        // accBest is the solid first hit when there is one, the pane otherwise: the same surface the accumulation reprojects.
        // NRD and DLSS-RR receive the effective bobbed camera pose, so IN_VIEWZ uses that same view space.
        float viewZ = -dot(accBest.pos - cameraOrigin(), bobCameraForward());
        imageStore(gbViewZ, p, vec4(viewZ, 0.0, 0.0, 0.0));
        if (StatsBuf(pc.statsAddr).motionAddr != uvec2(0u)) {
            Vec4Buf(StatsBuf(pc.statsAddr).motionAddr).v[p.y * size.x + p.x] = vec4(accBest.motion, (isEntityHit(accBest.slot) || dot(accBest.motion, accBest.motion) > 1.0e-8) ? 1.0 : 0.0);
        }
        vec3 nOut = hasFlag(FLAG_GEOMETRIC_NORMALS) ? accBest.ng : accBest.ns;
        vec3 n = length(nOut) > 1.0e-4 ? normalize(nOut) : vec3(0.0, 0.0, 1.0);
        float r = clamp(accBest.roughness, 0.0, 1.0);
        imageStore(gbNormalRough, p, vec4(n, r));
        // The path tracer sums diffuse and specular per sample: the split G-buffer channels stay empty and the whole
        // signal goes through the colour input as raw radiance (specular albedo is a material guide only).
        imageStore(gbSpecular, p, vec4(0.0));
        if (accHit) {
            vec3 a = max(accBest.albedoLit, vec3(0.02));
            vec3 specAlb = (accBest.metal > 0.5 || accBest.roughness < 0.6)
                ? (accBest.metal > 0.5 ? accBest.albedoTex : vec3(accBest.f0)) : vec3(0.0);
            imageStore(gbDiffuse, p, vec4(gbRestSum / float(spp), gbDist));
            imageStore(gbAlbedo, p, vec4(clamp(a, 0.0, 1.0), 1.0));
            imageStore(gbDirect, p, vec4(gbDirectSum / float(spp), 0.0));
            imageStore(gbSpecAlbedo, p, vec4(clamp(specAlb, 0.0, 1.0), 1.0));
        } else {
            imageStore(gbDiffuse, p, vec4((gbDirectSum + gbRestSum) / float(spp), gbDist));
            imageStore(gbAlbedo, p, vec4(1.0));
            imageStore(gbDirect, p, vec4(0.0));
            imageStore(gbSpecAlbedo, p, vec4(0.0));
        }
    } else {
        imageStore(gbViewZ, p, vec4(1.0e6, 0.0, 0.0, 0.0));
        StatsBuf fb = StatsBuf(pc.statsAddr);
        if (fb.motionAddr != uvec2(0u)) {
            vec4 prevClipDir = pc.invViewProj * vec4(((vec2(p) + 0.5) / vec2(size)) * 2.0 - 1.0, 0.5, 1.0);
            // A NaN here is a NaN motion vector for the whole sky, which the upscaler then reprojects from: same guards as the
            // camera ray in rt_common_temporal.glsl, safeW() for an Inf quotient and normalizeOr() for a 0/0 direction.
            vec3 skyDir = normalizeOr(prevClipDir.xyz / safeW(prevClipDir.w), rawCameraForward());
            vec4 pClip = fb.prevViewProj * vec4(skyDir, 0.0);
            vec2 pUv = pClip.w > 1e-6 ? (pClip.xy / pClip.w) * 0.5 + 0.5 : ((vec2(p) + 0.5) / vec2(size));
            vec2 mv = (pUv - ((vec2(p) + 0.5) / vec2(size))) * vec2(size);
            Vec4Buf(fb.motionAddr).v[p.y * size.x + p.x] = vec4(mv, 0.0, 0.0);
        }
        imageStore(gbNormalRough, p, vec4(0.0, 0.0, 1.0, 1.0));
        imageStore(gbDiffuse, p, vec4(0.0));
        imageStore(gbAlbedo, p, vec4(0.0));
        imageStore(gbDirect, p, vec4(0.0));
        imageStore(gbSpecular, p, vec4(0.0));
        imageStore(gbSpecAlbedo, p, vec4(0.0));
    }
#endif
}
