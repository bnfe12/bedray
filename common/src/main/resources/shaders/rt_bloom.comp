#version 460
// Bloom and sun glare as a post pass on the final image (RtBloomPass). One shader, BLOOM_STAGE selects the dispatch:
//  0  prefilter + first downsample: the display image (RGBA8, already tone mapped) is converted back to scene space with
//     tonemapInverse(), the soft threshold is applied to the PEAK channel (emission and the sun disk, not the sky), a Karis average
//     over the 13 taps suppresses fireflies. Writes mip 0 (half resolution, RGBA16F).
//  1  downsample mip i-1 -> i (13 tap filter of Jimenez 2014, "Next Generation Post Processing in Call of Duty: Advanced Warfare").
//  2  upsample: mip i = mix(mip i, tent(mip i+1), scatter); in place, every thread touches only its own texel of mip i.
//  3  apply: image = image + (tonemapColor(lin + bloom + glare) - tonemapColor(lin)), i.e. the glow is added BEFORE the shoulder of
//     the tone map (a glowing lamp saturates towards white only as far as the curve allows, colours of the emission survive) and a
//     pixel without glow is bit identical. Sun glare (halo + optional 6 point star) is added in the same step.
// Descriptors: 0 sampled source, 1 storage RGBA16F (destination / in-out mip), 2 storage RGBA8 final image, 3 sampled ray distance (texelFetch).
#include "rt_tonemap.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex;
layout(set = 0, binding = 1, rgba16f) uniform image2D dstImg;
layout(set = 0, binding = 2, rgba8) uniform image2D finalImg;
layout(set = 0, binding = 3) uniform sampler2D depthTex;

layout(push_constant) uniform PC {
    mat4 invViewProj;   //   0 clip -> camera-relative world (no jitter)
    vec4 sunDir;        //  64 xyz towards the key light, w glare strength (0 = off)
    vec4 camOrigin;     //  80 xyz bob origin of the camera, w 1 = flip Y
    vec4 p0;            //  96 x threshold (scene units), y knee, z bloom strength, w star amount
    vec4 p1;            // 112 x 1 = image is tone mapped, y scatter (mix of the wider mip), z/w sun position in NDC
} pc;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

vec3 toScene(vec3 display) {
    return pc.p1.x > 0.5 ? tonemapInverse(display) : display;
}

float peak(vec3 c) {
    return max(c.r, max(c.g, c.b));
}

// soft threshold on the peak channel: 0 below threshold - knee, linear above threshold + knee, quadratic in between
vec3 prefilter(vec3 c) {
    float m = peak(c);
    float knee = max(pc.p0.y, 1.0e-4);
    float soft = clamp(m - pc.p0.x + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee + 1.0e-5);
    float contrib = max(soft, m - pc.p0.x) / max(m, 1.0e-4);
    return c * max(contrib, 0.0);
}

vec3 fetchPre(vec2 uv) {
    // the sky and the clouds never glow (their bright edge against dark blocks was the halo around every silhouette); the sun has its glare
    ivec2 dp = clamp(ivec2(uv * vec2(textureSize(depthTex, 0))), ivec2(0), textureSize(depthTex, 0) - 1);
    if (texelFetch(depthTex, dp, 0).r >= 1.0e5) {
        return vec3(0.0);
    }
    vec3 c = toScene(textureLod(srcTex, uv, 0.0).rgb);
    return prefilter(c);
}

float karis(vec3 c) {
    return 1.0 / (1.0 + dot(c, LUMA));
}

vec3 down13(vec2 uv, vec2 texel, bool pre) {
    vec3 a, b, c, d, e, f, g, h, i, j, k, l, m;
#define TAP(dx, dy) (pre ? fetchPre(uv + vec2(dx, dy) * texel) : textureLod(srcTex, uv + vec2(dx, dy) * texel, 0.0).rgb)
    a = TAP(-2, -2); b = TAP(0, -2); c = TAP(2, -2);
    d = TAP(-2, 0);  e = TAP(0, 0);  f = TAP(2, 0);
    g = TAP(-2, 2);  h = TAP(0, 2);  i = TAP(2, 2);
    j = TAP(-1, -1); k = TAP(1, -1); l = TAP(-1, 1); m = TAP(1, 1);
#undef TAP
    if (pre) {
        // Karis average of the five 4-tap groups (first mip only)
        vec3 g0 = (a + b + d + e) * 0.25;
        vec3 g1 = (b + c + e + f) * 0.25;
        vec3 g2 = (d + e + g + h) * 0.25;
        vec3 g3 = (e + f + h + i) * 0.25;
        vec3 g4 = (j + k + l + m) * 0.25;
        float w0 = karis(g0) * 0.125, w1 = karis(g1) * 0.125, w2 = karis(g2) * 0.125, w3 = karis(g3) * 0.125, w4 = karis(g4) * 0.5;
        return (g0 * w0 + g1 * w1 + g2 * w2 + g3 * w3 + g4 * w4) / (w0 + w1 + w2 + w3 + w4);
    }
    return e * 0.125 + (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (j + k + l + m) * 0.125;
}

// 3x3 tent upsample (radius 1 texel of the source)
vec3 up9(vec2 uv, vec2 texel) {
    vec3 s = textureLod(srcTex, uv, 0.0).rgb * 4.0;
    s += textureLod(srcTex, uv + vec2(-texel.x, 0.0), 0.0).rgb * 2.0;
    s += textureLod(srcTex, uv + vec2(texel.x, 0.0), 0.0).rgb * 2.0;
    s += textureLod(srcTex, uv + vec2(0.0, -texel.y), 0.0).rgb * 2.0;
    s += textureLod(srcTex, uv + vec2(0.0, texel.y), 0.0).rgb * 2.0;
    s += textureLod(srcTex, uv + vec2(-texel.x, -texel.y), 0.0).rgb;
    s += textureLod(srcTex, uv + vec2(texel.x, -texel.y), 0.0).rgb;
    s += textureLod(srcTex, uv + vec2(-texel.x, texel.y), 0.0).rgb;
    s += textureLod(srcTex, uv + vec2(texel.x, texel.y), 0.0).rgb;
    return s / 16.0;
}

vec3 sanitize(vec3 c) {
    if (any(isnan(c)) || any(isinf(c))) {
        return vec3(0.0);
    }
    return clamp(c, vec3(0.0), vec3(65000.0));
}

#if BLOOM_STAGE == 0 || BLOOM_STAGE == 1
void main() {
    ivec2 size = imageSize(dstImg);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec2 texel = 1.0 / vec2(textureSize(srcTex, 0));
    imageStore(dstImg, p, vec4(sanitize(down13(uv, texel, BLOOM_STAGE == 0)), 1.0));
}
#elif BLOOM_STAGE == 2
void main() {
    ivec2 size = imageSize(dstImg);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec3 own = imageLoad(dstImg, p).rgb;
    vec3 wide = up9(uv, 1.0 / vec2(textureSize(srcTex, 0)));
    imageStore(dstImg, p, vec4(sanitize(mix(own, wide, pc.p1.y)), 1.0));
}
#else
// ---- apply ----
vec3 pixelDir(ivec2 p, ivec2 size) {
    vec2 ndc = (vec2(p) + 0.5) / vec2(size) * 2.0 - 1.0;
    if (pc.camOrigin.w > 0.5) {
        ndc.y = -ndc.y;
    }
    vec4 w = pc.invViewProj * vec4(ndc, 0.5, 1.0);
    return normalize(w.xyz / w.w - pc.camOrigin.xyz);
}

// Fraction of the sun disk that is visible: sky pixels (ray distance >= 1e5) that are on the actual solar disk core
// around the projected sun position; 0 when the sun is occluded by foliage/terrain or outside the frame.
float sunVisibility(ivec2 size) {
    vec2 ndc = pc.p1.zw;
    float edge = max(abs(ndc.x), abs(ndc.y));
    float fade = 1.0 - smoothstep(0.95, 1.25, edge);
    if (fade <= 0.0) {
        return 0.0;
    }
    vec2 center = clamp((ndc * 0.5 + 0.5) * vec2(size), vec2(1.0), vec2(size) - 1.0);
    // Require the center of the sun disk itself or its immediate core to be unoccluded sky
    float r = 0.014 * float(size.y);
    float vis = 0.0;
    float wSum = 0.0;
    for (int i = 0; i < 9; i++) {
        vec2 o = i == 0 ? vec2(0.0) : vec2(cos(float(i) * 0.785398), sin(float(i) * 0.785398)) * r * (i < 5 ? 0.45 : 0.95);
        float w = i == 0 ? 2.5 : (i < 5 ? 1.2 : 0.7);
        ivec2 t = clamp(ivec2(center + o), ivec2(0), size - 1);
        float sky = texelFetch(depthTex, t, 0).r >= 1.0e5 ? 1.0 : 0.0;
        vec3 sc = imageLoad(finalImg, t).rgb;
        // Daytime blue sky has high blue (~0.9) but lower red/green; the sun disk is warm-white (all channels high, luma > 0.88)
        float sunLum = dot(sc, LUMA);
        float bright = smoothstep(0.88, 0.98, sunLum) * smoothstep(0.85, 0.96, sc.r);
        vis += sky * bright * w;
        wSum += w;
    }
    float rawVis = vis / max(wSum, 1.0e-4);
    // Smoothly suppress glare when most of the solar disk is hidden behind tree leaves
    return smoothstep(0.22, 0.75, rawVis) * fade;
}

void main() {
    ivec2 size = imageSize(finalImg);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec3 add = pc.p0.z > 0.0 ? textureLod(srcTex, uv, 0.0).rgb * pc.p0.z : vec3(0.0);

    float glareK = pc.sunDir.w;
    if (glareK > 0.0) {
        vec3 d = pixelDir(p, size);
        float cosA = dot(d, normalize(pc.sunDir.xyz));
        if (cosA > 0.0) {
            float theta = acos(clamp(cosA, -1.0, 1.0));
            bool pixelIsSky = texelFetch(depthTex, p, 0).r >= 1.0e5;
            // On foreground geometry (trees/blocks), only allow a soft tight atmospheric bleed near the sun core, never long star spikes
            float fgMask = pixelIsSky ? 1.0 : (0.18 * exp(-theta / 0.045));
            // halo: compact Lorentzian core + gentle exponential glow
            float g = (0.38 / (1.0 + (theta / 0.028) * (theta / 0.028)) + 0.045 * exp(-theta / 0.18)) * fgMask;
            if (pc.p0.w > 0.0 && pixelIsSky) {
                vec2 rel = (uv - (pc.p1.zw * 0.5 + 0.5)) * vec2(float(size.x) / float(size.y), 1.0);
                if (pc.camOrigin.w > 0.5) {
                    rel.y = -rel.y;
                }
                float r = length(rel);
                float phi = atan(rel.y, rel.x);
                g += pc.p0.w * pow(abs(cos(3.0 * phi)), 48.0) * 0.18 * exp(-r / 0.14);
            }
            if (g > 1.0e-3) {
                float vis = sunVisibility(size);
                add += vec3(1.0, 0.93, 0.80) * (g * 2.2 * glareK * vis);
            }
        }
    }

    add = sanitize(add);
    if (peak(add) <= 1.0e-4) {
        return;
    }
    vec4 c = imageLoad(finalImg, p);
    vec3 delta;
    if (pc.p1.x > 0.5) {
        vec3 lin = tonemapInverse(c.rgb);
        delta = tonemapColor(lin + add) - tonemapColor(lin);
    } else {
        delta = add;
    }
    imageStore(finalImg, p, vec4(clamp(c.rgb + delta, 0.0, 1.0), c.a));
}
#endif
