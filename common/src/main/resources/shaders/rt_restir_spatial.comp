#version 460
// ReSTIR DI spatial reuse (Bitterli et al. 2021, "Spatiotemporal reservoir resampling for real-time ray tracing with dynamic
// direct lighting"): runs after rt_rays.comp, two dispatches per frame. The checker phase rides in params2 bits 16-19 (the
// a-trous filter reuses that nibble for its own iterations; the two passes never run interleaved, and the ray pass itself only
// ever sees 0 there). Pixels whose (x + y) parity equals the phase merge neighbour reservoirs from the opposite parity - the
// cells written this pass are exactly the cells not read, so the in-place update cannot tear a record a neighbour still reads.
// The second phase re-reads the first phase's results (iterated spatial reuse). The merged record stays in this frame's parity
// half, so next frame's temporal reuse (rt_common_emitters.glsl) imports spatially pooled history. No shadow rays here: a
// reservoir is a sample distribution, visibility is evaluated by the ray pass on the sample it finally shades with.
#include "rt_common.glsl"

const int SPATIAL_RADIUS = 4;      // screen-space radius in pixels (mission brief: disk radius 4)
const int SPATIAL_DRAWS = 8;       // draws per pixel; the opposite-parity restriction keeps 3-5 effective merges

void main() {
    ivec2 size = imageSize(outImage);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    StatsBuf fb = StatsBuf(pc.statsAddr);
    if (fb.reservoirAddr.x == 0u || fb.reservoirAuxAddr.x == 0u || emitterCount() == 0u) {
        return;   // all reservoirs are empty records already: nothing to merge, nothing to propagate
    }
    int phase = int((params2() >> 16u) & 15u) & 1;
    if (((p.x + p.y) & 1) != phase) {
        return;   // not a writer this pass
    }
    uint pixels = uint(size.x) * uint(size.y);
    uint width = uint(size.x);
    uint cur = uint(pc.frame & 1u);
    uint slot = cur * pixels + uint(p.y) * width + uint(p.x);
    Reservoir own = ReservoirBuf(fb.reservoirAddr).r[slot];
    if (!(own.meta.x > 0.0)) {
        return;   // this pixel shaded no emissive term this frame: its slot still holds an older frame's receiver (NaN count too)
    }
    vec3 auxP = ReservoirAuxBuf(fb.reservoirAuxAddr).r[slot].xyz;
    vec3 nP = unpackReservoirNormal(own.meta.z);
    if ((uint(own.meta.y) & 2u) != 0u) {
        nP.z = -nP.z;   // receiver normal faced down (ceiling): the packed xy lost the sign of z
    }
    // Receiver of this pixel as a pseudo surface for the target p^ of imported samples: importing must re-evaluate the
    // neighbour's sample here, exactly like the temporal merge re-evaluates the history sample. The self-emission flag
    // (meta.y bit 2) keeps emitterPhat's self-shadowing guard, maxDist is this frame's emissive reach.
    Surface sLoc;
    sLoc.pos = auxP;
    sLoc.ns = nP;
    sLoc.emission = (uint(own.meta.y) & 4u) != 0u ? 1.0 : 0.0;
    float maxDist = fb.emisDist;

    float wsum = own.leWsum.w;
    float count = own.meta.x;
    vec3 winY = own.yTexEm.xyz;
    float winEm = own.yTexEm.w;
    vec3 winEn = own.enPhat.xyz;
    float winPhat = own.enPhat.w;
    vec3 winLe = own.leWsum.xyz;
    uint seed = pcgHash(uint(p.x) * 1973u + uint(p.y) * 9277u + pc.frame * 26699u + 7u);
    float planeTol = 0.05 * max(own.meta.w, 1.0) + 0.1;   // receiver plane tolerance, as the history distance test
    bool won = false;
    for (int j = 0; j < SPATIAL_DRAWS; j++) {
        vec2 u = vec2(rand01(seed), rand01(seed));
        ivec2 off = ivec2(round(u * 14.0)) - 7;           // uniform in [-7, 7] per axis
        if (((off.x + off.y) & 1) == 0) {
            off.x += off.x >= 0 ? 1 : -1;                 // opposite checker colour: (dx + dy) odd, radius stays <= 8
        }
        ivec2 q = p + off;
        if (q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y) {
            continue;
        }
        uint qSlot = cur * pixels + uint(q.y) * width + uint(q.x);
        Reservoir nb = ReservoirBuf(fb.reservoirAddr).r[qSlot];
        float mNb = min(nb.meta.x, RESTIR_M_CAP);         // same cap as the temporal merge: bounds the M growth
        if (!(mNb > 0.0)) {
            continue;                                     // empty or NaN-count neighbour: its weights are not usable
        }
        vec3 auxQ = ReservoirAuxBuf(fb.reservoirAuxAddr).r[qSlot].xyz;
        vec3 nQ = unpackReservoirNormal(nb.meta.z);
        if ((uint(nb.meta.y) & 2u) != 0u) {
            nQ.z = -nQ.z;
        }
        if (dot(nQ, nP) < 0.85) {
            continue;                                     // normal rejection (mission brief): walls must not import each other's light
        }
        if (abs(dot(auxQ - auxP, nP)) > planeTol) {
            continue;                                     // plane rejection: a light sample behind a step stays local
        }
        vec3 dQ = nb.yTexEm.xyz - sLoc.pos;               // emitterPhat takes the squared receiver-to-sample distance
        float phatQ = emitterPhat(nb.yTexEm.xyz, dot(dQ, dQ), nb.yTexEm.w, nb.enPhat.xyz, (uint(nb.meta.y) & 1u) != 0u, sLoc,
            maxDist);
        if (!(phatQ > 0.0)) {
            continue;                                     // zero or NaN target p^ (NaN passes a <= 0.0 test)
        }
        // Import weight: neighbour cumulative weight rescaled from its receiver to this one. The sample is an area-parameterized
        // point on the emitter quad, so the receiver change carries no Jacobian (|J| = 1); the firefly clamp bounds the ratio.
        float ratio = clamp(phatQ / max(nb.enPhat.w, 1.0e-4), 0.0, RESTIR_SPATIAL_RATIO_CAP);
        float wQ = nb.leWsum.w * (mNb / max(nb.meta.x, 1.0)) * ratio;
        float accept = wQ / max(wsum + wQ, 1.0e-8);
        wsum += wQ;
        count += mNb;
        if (rand01(seed) < accept) {
            winY = nb.yTexEm.xyz;
            winEm = nb.yTexEm.w;
            winEn = nb.enPhat.xyz;
            winPhat = phatQ;                              // target p^ of the winner at THIS receiver
            winLe = nb.leWsum.xyz;
            won = true;
        }
    }
    if (won) {
        // The merged record is imported by next frame's temporal reuse (rt_common_emitters.glsl), so a non-finite weight here does
        // not only break this pixel: it poisons every receiver that merges this slot. The neighbour fields are read straight from
        // the reservoir buffer, where the ray pass can leave a NaN weight or a NaN sample position behind.
        if (!(wsum >= 0.0) || !(count > 0.0) || !(winPhat > 0.0) || isnan(winEm) || isinf(winEm)
            || any(isnan(winY)) || any(isinf(winY)) || any(isnan(winEn)) || any(isinf(winEn))
            || any(isnan(winLe)) || any(isinf(winLe))) {
            return;   // keep this pixel's own pre-spatial record instead of storing a reservoir no receiver can shade with
        }
        Reservoir outR = own;                             // meta (receiver normal, distance, flags) stays this pixel's
        outR.yTexEm = vec4(winY, winEm);
        outR.enPhat = vec4(winEn, winPhat);
        outR.leWsum = vec4(winLe, wsum);
        outR.meta.x = count;
        ReservoirBuf(fb.reservoirAddr).r[slot] = outR;
    }
}
