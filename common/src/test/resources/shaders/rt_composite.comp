#version 460

// Screen-space depth composite pass: blends rasterized foreground entities (mobs, items, chests, particles)
// from the engine render target over the ray-traced world (rtColor) based on depth comparison.
// Pixels where raster depth is closer than ray-traced depth (or where ray missed into sky while raster
// has a foreground entity) contain rasterized entities and are preserved, while raster terrain and sky
// are replaced by the ray-traced image. Supports alpha blending for translucent entities and particles.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Binding 0: Raster world color target (RGBA8)
layout(set = 0, binding = 0) uniform sampler2D rasterColor;
// Binding 1: Raster world depth buffer (D32_FLOAT, Reverse-Z: near = 1.0, far/sky = 0.0)
layout(set = 0, binding = 1) uniform sampler2D rasterDepth;
// Binding 2: Ray-traced world color (RGBA8)
layout(set = 0, binding = 2) uniform sampler2D rtColor;
// Binding 3: Ray hit distance in meters (R32F; 1e6 on miss/sky)
layout(set = 0, binding = 3) uniform sampler2D rtDepth;
// Binding 4: Destination composite target (RGBA8, storage image)
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D outComposite;

layout(push_constant) uniform PC {
    mat4 invViewProj;       // unjittered inverse view-projection matrix (clip -> camera-relative world)
    uvec2 size;             // target width and height
    float depthThreshold;   // depth epsilon threshold in meters (e.g. 0.08)
    float pad;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) {
        return;
    }

    vec2 uv = (vec2(p) + 0.5) / vec2(pc.size);

    vec4 rColor = texelFetch(rasterColor, p, 0);
    float dRaster = texelFetch(rasterDepth, p, 0).r; // Reverse-Z: 1.0 near, 0.0 far/sky
    vec4 rtCol = texelFetch(rtColor, p, 0);
    float dRay = texelFetch(rtDepth, p, 0).r;        // Ray hit distance in meters

    // Reverse-Z: sky has depth 0.0 (or near zero). For sky pixels, always show the ray-traced sky.
    if (dRaster <= 1.0e-6) {
        imageStore(outComposite, p, rtCol);
        return;
    }

    // Reconstruct camera-relative distance of the raster surface in meters
    vec4 clip = vec4(uv * 2.0 - 1.0, dRaster, 1.0);
    vec4 worldPosRel = pc.invViewProj * clip;
    float distRaster = (abs(worldPosRel.w) > 1.0e-7) ? length(worldPosRel.xyz / worldPosRel.w) : 1.0e6;

    // Evaluate depth:
    // Dynamic adaptive threshold: at least 0.20m (20cm), scaling with 5% of distance.
    // Chunk terrain surfaces matching within this tolerance are NEVER classified as entities.
    float thresh = max(pc.depthThreshold > 0.0 ? pc.depthThreshold : 0.20, dRay * 0.05);

    bool isEntity = false;
    if (dRay >= 1.0e5) {
        // Ray missed into sky, but raster contains a foreground entity/object
        if (distRaster <= 256.0) {
            isEntity = true;
        }
    } else {
        // If the raster surface is strictly in front of the ray-traced chunk geometry by more than the threshold:
        // this pixel contains a rasterized entity (mob, player, item, chest, particle)!
        if (distRaster < dRay - thresh) {
            isEntity = true;
        } else if (distRaster < 1.2 && distRaster < dRay - 0.05) {
            // First-person hand / held item in immediate camera foreground (distRaster < 1.2m),
            // strictly in front of terrain
            isEntity = true;
        }
    }

    if (isEntity && rColor.a > 0.0) {
        // Alpha blending for entities (supports both opaque and translucent entities / particles)
        float a = clamp(rColor.a, 0.0, 1.0);
        vec3 blended = mix(rtCol.rgb, rColor.rgb, a);
        imageStore(outComposite, p, vec4(blended, max(rtCol.a, a)));
        return;
    }

    // Raster terrain background is replaced by the ray-traced world
    imageStore(outComposite, p, rtCol);
}
